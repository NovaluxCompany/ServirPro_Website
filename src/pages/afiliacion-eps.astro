---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import ComplianceNotice from "../components/sections/common/ComplianceNotice.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import ContactSection from "../components/sections/arlEnrollment/ContactSection.astro";
import Hero from "../components/sections/arlEnrollment/Hero.astro";
import Description from "../components/sections/arlEnrollment/Description.astro";
import Detail from "../components/sections/arlEnrollment/Detail.astro";
import ExperienceSection from "../components/sections/arlEnrollment/ExperienceSection.astro";
import TrustSection from "../components/sections/arlEnrollment/TrustSection.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";

import { whatsappLinks } from "../utils/whatsapp";
---

<Layout title="Servicios | ServirPRO" whatsapp={whatsappLinks.cotizarEps}>
  <Header />
  <main class="bg-white">
    <Hero />
    <Description />
    <Detail />
    <OfficesCarousel />
    <ExperienceSection />
    <TrustSection />
    <Testimonials />
    <ContactSection />
  </main>
  <ComplianceNotice
    text="ServirPRO Seguros es una empresa privada que brinda servicios de asesoría y orientación en Seguridad Social y seguros. No somos una entidad gubernamental ni una EPS. Servicio sujeto a condiciones y tarifas."
  />
  <Footer whatsapp={whatsappLinks.cotizarArl} showComplianceNote />
</Layout>
