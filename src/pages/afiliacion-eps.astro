---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import ContactSection from "../components/sections/arlEnrollment/ContactSection.astro";
import Hero from "../components/sections/arlEnrollment/Hero.astro";
import Description from "../components/sections/arlEnrollment/Description.astro";
