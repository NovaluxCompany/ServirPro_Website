---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import FamilySection from "../components/sections/lifesInsurance/FamilySection.astro";
import Hero from "../components/sections/lifesInsurance/Hero.astro";
import LifeDescription from "../components/sections/lifesInsurance/LifeDescription.astro";
import LifethDetail from "../components/sections/lifesInsurance/LifeDetail.astro";
import BannerServirProLocation from "../components/sections/lifesInsurance/BannerServirProLocationLifeInsurance.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";
---

<Layout title="Servicios | ServirPRO">
  <Header />
  <main class="bg-white">
    <Hero />
    <LifeDescription />
    <LifethDetail />
    <OfficesCarousel />
    <BannerServirProLocation />
    <Testimonials />
    <FamilySection />
  </main>
  <Footer />
