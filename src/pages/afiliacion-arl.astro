---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import ComplianceNotice from "../components/sections/common/ComplianceNotice.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import ContactSection from "../components/sections/healthEnrollment/ContactSection.astro";
import Hero from "../components/sections/healthEnrollment/Hero.astro";
import Description from "../components/sections/healthEnrollment/Description.astro";
import Detail from "../components/sections/healthEnrollment/Detail.astro";
import BannerServirProLocation from "../components/sections/common/BannerServirProLocation.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";

import { whatsappLinks } from "../utils/whatsapp";
---

<Layout title="Servicios | ServirPRO" whatsapp={whatsappLinks.cotizarArl}>
  <Header />
  <main class="bg-white">
    <Hero />
    <Description />
    <Detail />
    <OfficesCarousel />
    <BannerServirProLocation />
    <Testimonials />
    <ContactSection />
  </main>
  <ComplianceNotice
    text="ServirPRO Seguros es una empresa privada que brinda servicios de asesoría y orientación en Seguridad Social y seguros. No somos una entidad gubernamental ni una ARL. Servicio sujeto a condiciones y tarifas."
  />
  <Footer
    whatsapp={whatsappLinks.cotizarArl}
    showComplianceNote
    complianceNoteText="ServirPRO Seguros presta servicios privados de asesoría y orientación en procesos de Seguridad Social. No afiliamos ni gestionamos directamente ante la ARL."
  />
</Layout>
