---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import ComplianceNotice from "../components/sections/common/ComplianceNotice.astro";
import Hero from "../components/sections/groupInsurancePolices/Hero.astro";
import Description from "../components/sections/groupInsurancePolices/Description.astro";
import Detail from "../components/sections/groupInsurancePolices/Detail.astro";
import BannerServirProLocation from "../components/sections/common/BannerServirProLocation.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import ContactSectionBanner from "../components/sections/groupInsurancePolices/ContactSectionBanner.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";

import { whatsappLinks } from "../utils/whatsapp";
---

<Layout
  title="Servicios | ServirPRO"
  whatsapp={whatsappLinks.cotizarPlanPolizaColectiva}
>
  <Header />
  <main class="bg-white">
    <Hero />
    <Description />
    <Detail />
    <OfficesCarousel />
    <BannerServirProLocation />
    <Testimonials />
    <ContactSectionBanner />
  </main>
  <ComplianceNotice />
  <Footer />
</Layout>
