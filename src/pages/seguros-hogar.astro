---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import InsuranceDescription from "../components/sections/homeInsurance/InsuranceDescription.astro";
import InsuranceDetail from "../components/sections/homeInsurance/InsuranceDetail.astro";
import BannerServirProLocation from "../components/sections/common/BannerServirProLocation.astro";
import ContactSectionBanner from "../components/sections/homeInsurance/ContactSectionBanner.astro";
import InsuranceHero from "../components/sections/homeInsurance/InsuranceHero.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";
---

<Layout title="Servicios | ServirPRO">
  <Header />
  <main class="bg-white">
    <InsuranceHero />
    <InsuranceDescription />
    <InsuranceDetail />
    <OfficesCarousel />
    <BannerServirProLocation />
