---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/sections/common/Header.astro";
import Footer from "../components/sections/common/Footer.astro";
import Testimonials from "../components/sections/common/Testimonials.astro";
import Description from "../components/sections/vehiclePurchase/Description.astro";
import Detail from "../components/sections/vehiclePurchase/Detail.astro";
import PaternsSection from "../components/sections/vehiclePurchase/PaternsSection.astro";
import ContactSectionBanner from "../components/sections/vehiclePurchase/ContactSectionBanner.astro";
import Hero from "../components/sections/vehiclePurchase/Hero.astro";
import OfficesCarousel from "../components/sections/OfficesCarousel.astro";

import { whatsappLinks } from "../utils/whatsapp";
---

<Layout
  title="Servicios | ServirPRO"
  whatsapp={whatsappLinks.bajarCuotaVehiculo}
>
  <Header />
  <main class="bg-white">
    <Hero />
    <Description />
    <Detail />
    <PaternsSection />
    <OfficesCarousel />
    <Testimonials />
    <ContactSectionBanner />
  </main>
  <Footer />
</Layout>
