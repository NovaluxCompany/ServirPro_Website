---
import { Image } from 'astro:assets';
import heroBg from '../../../assets/images/companyArl/Hero.webp';
import heroBgMobile from '../../../assets/images/vehicleInsurance/Hero-mobile.webp';

// HealthPolicySection.astro - Versión con imagen cubriendo 100% de ancho del diseño
const policyTitle = `Intermediación en
ARL para empresas`;
const subtitle = "Cumple con la ley y protege a tu equipo";
const description = "con el respaldo de las mejores aseguradoras.";
const buttonText = "Asesoría gratuita";
---

<section class="h-[70vh] min-h-[70vh] max-h-[70vh] sm:h-screen sm:max-h-[80vh] sm:min-h-0 sm:max-h-none">
  <div class="w-full h-full">
    <div 
      class="relative overflow-hidden h-full sm:min-h-[500px] md:min-h-[580px] lg:min-h-[700px]"
    >
      <!-- Imagen de fondo usando el componente Image -->
      <!-- Desktop y Tablet -->
      <Image src={heroBg} alt="Seguro vehicular" class="absolute inset-0 w-full h-full object-cover hidden sm:block" />
      <!-- Mobile -->
      <Image src={heroBgMobile} alt="Seguro vehicular mobile" class="absolute inset-0 w-full h-full border-none object-cover sm:hidden" />
      
      <!-- Banda de título en tablet y desktop: fija a la derecha -->
      <div id="title-band" class="hidden sm:block absolute top-24 md:top-28 lg:top-28 right-0 w-[45%] md:w-[50%] bg-servir-blue-dark rounded-l-full rounded-r-none shadow-md z-10 py-3 md:py-4 px-4 md:px-6">
        <h2 class="font-extrabold text-white leading-tight text-center text-3xl md:text-4xl lg:text-5xl whitespace-pre-line">{policyTitle}</h2>
      </div>
      
      <div class="absolute inset-0 bg-opacity-20 sm:hidden"></div>
      
      <!-- Contenedor para móvil -->
      <div class="sm:hidden absolute inset-0 flex flex-col justify-end pb-8 px-6">
        <div class="w-full">
          <div class="text-center w-full space-y-4">
            <!-- Título en móvil: caja azul centrada -->
            <div class="inline-block py-4 px-8 rounded-3xl bg-servir-blue-dark shadow-md w-full">
              <h2 class="text-3xl font-extrabold text-white leading-tight whitespace-pre-line">
                {policyTitle}
              </h2>
            </div>

            <!-- Subtítulo y descripción -->
            <div class="space-y-1 mb-15">
              <p class="text-xl font-bold text-[#5793ce] leading-tight">{subtitle}</p>
              <p class="text-xl text-servir-blue-dark leading-tight">
                {description}
              </p>
            </div>
            
            <!-- Botón -->
            <div class="pt-4">
              <a href="#" class="button-container button-text inline-block px-8 py-3 text-base font-bold text-black bg-servir-green w-full rounded-full shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl">
                {buttonText}
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Contenedor para tablet y desktop -->
      <div class="hidden sm:block">
        <!-- Contenido posicionado debajo de la banda, centrado respecto a ella -->
        <div class="absolute right-0 w-[45%] md:w-[40%] z-10 sm:top-[200px] md:top-[220px] lg:top-[270px]">
          <div class=" md:p-6 lg:p-7">
            <div class="text-center w-full">
              <p class="text-lg sm:text-xl md:text-2xl lg:text-2xl font-bold text-[#5793ce] leading-snug">
                {subtitle}

                <span class="sm:text-lg md:text-2xl lg:text-2xl  mb-6 md:mb-8 font-semibold" style="color:#4b4746">
                  {description}
                </span>
              </p>

              <a href="#" class=" button-container inline-block w-100  mt-4 sm:mt-6 md:mt-8 px-6 sm:px-8 py-2 sm:py-3 text-sm sm:text-base md:text-lg font-bold text-black bg-servir-green rounded-full shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl">
                {buttonText}
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>