---
import { Image } from "astro:assets";
import BenefitItem from "../../ui/BenefitItem.astro";
import { whatsappLinks } from "../../../utils/whatsapp";

// Imagen del título
import tituloImg from "../../../assets/images/companyArl/Title.webp";

// Iconos
import icon1 from "../../../assets/iconos/companyArl/icon-nike.svg";
import icon2 from "../../../assets/iconos/companyArl/icon-corazon.svg";
import icon3 from "../../../assets/iconos/health-services/icon-autorizaciones.svg";
import icon4 from "../../../assets/iconos/lifeInsurance/futuro-seguro.svg";
import icon5 from '../../../assets/iconos/vehicleInsurance/icon-setting.webp';
import icon7 from '../../../assets/iconos/lifeInsurance/cobertura-deudas.svg';
---

<section
  class="w-full flex flex-col items-center justify-center text-center px-6 py-10 md:py-16 bg-white"
>
  <!-- Imagen del título -->
  <div class="mb-12">
    <Image
      src={tituloImg}
      alt="Contar con un intermediario en ARL"
      class="mx-auto w-[400px] md:w-[760px]"
    />
  </div>

  <!-- Beneficios -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl mb-10">
    <BenefitItem 
      icon={icon1} 
      alt="Especialistas" 
      text={`Aprovechar todos los beneficios
incluidos en tu ARL, sin pagar nada adicional.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon2} 
      alt="Autorizaciones" 
      text={`Recibir asesoría personalizada para
identificar riesgos laborales y
reducir incidentes.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon4} 
      alt="Clínicas y hospitales" 
      text={`Proteger a tus empleados con
acompañamiento activo en
seguridad y salud en el trabajo.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon3} 
      alt="Habitación preferencial" 
      text={`Cumplir con la normatividad mientras
aprovechas capacitaciones y
programas gratuitos.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon5} 
      alt="Cobertura internacional"  
      text={`Gestionar afiliaciones, novedades
y reportes de forma rápida, sin
perder tiempo en trámites.`} 
      showBorderMobileOnly={true}
    />
    
    <BenefitItem 
      icon={icon7} 
      alt="Atención domiciliaria" 
      text={`Ahorrar dinero y recursos, gracias
a un servicio 100% gratuito
para tu empresa.`} 
      showBorder={false}
    />
  </div>

  <!-- Botón Cotizar -->
  <a href={whatsappLinks.cotizarArlEmpresas} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green transition mb-12">
    Asesoría gratuita
  </a>


  <!-- Pasos -->
  <div class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative">
    <!-- Paso 1 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >
        Solicita tu asesoría.
      </p>
    </div>

    <!-- Paso 2 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >
        Recibe acompañamiento gratuito y personalizado.
    </p>
    </div>

    <!-- Paso 3 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >
        Aprovecha todos los beneficios de tu ARL.
      </p>
    </div>
  </div>


  <!-- Segundo botón -->
  <a href={whatsappLinks.cotizarArlEmpresas} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green">
    Asesoría gratuita
  </a>
</section>
