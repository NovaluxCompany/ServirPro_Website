---
// FamilySection.astro - Sección de tranquilidad con imagen de familia
import { Image } from "astro:assets";
import contactWebImage from "../../../assets/images/lifeInsurance/familia.webp";
import check from "../../../assets/iconos/lifeInsurance/Check-green.svg";
import contactMobileImage from "../../../assets/images/lifeInsurance/contact-section_mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";

---

<!-- Sección de Tranquilidad con Imagen de Familia -->
<section
  class="relative py-12 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden min-h-[500px] md:min-h-[600px]"
>

  <!-- Fondo Desktop -->
  <Image
    src={contactWebImage}
    alt="Familia feliz"
    class="absolute inset-0 w-full h-full object-cover hidden sm:block z-0"
    loading="eager"
  />

  <!-- Fondo Mobile -->
  <Image
    src={contactMobileImage}
    alt="Familia feliz mobile"
    class="absolute inset-0 w-full h-full object-cover sm:hidden z-0"
    loading="eager"
  />

  <!-- Contenido -->
  <div class="relative z-20 max-w-7xl mx-auto">
    <!-- TODO tu contenido aquí (NO CAMBIA) -->

    <div class="max-w-2xl">
      
      <!-- Mobile: contenido centrado -->
      <div class="sm:hidden text-center px-4">
        <h2 class="text-xl text-left font-bold mb-4 leading-tight">
          <span class="text-[#0B2D49]">Comprar</span> <span class="text-[#4A88B7]">un seguro de </span><br />
          <span class="text-[#4A88B7]">vida, es regalar protección </span><br />
          <span class="text-[#4A88B7]">y tranquilidad</span> <span class="text-[#0B2D49]">a tu familia</span>
        </h2>

        <p class="text-xs text-left leading-relaxed mb-4 text-black font-medium">
          Que pase lo que pase, estará protegida<br />
          y respaldada si algún día tú faltas.
        </p>

        <!-- Lista con checks -->
        <div class="text-left mb-6 space-y-2">
          <div class="flex items-center gap-2">
            <Image src={check} alt="Check" class="w-5 h-5 flex-shrink-0" />
            <span class="text-sm text-black font-medium">Fácil y rápido online</span>
          </div>
          <div class="flex items-center gap-2">
            <Image src={check} alt="Check" class="w-5 h-5 flex-shrink-0" />
            <span class="text-sm text-black font-medium">Planes pensados en familias</span>
          </div>
          <div class="flex items-center gap-2">
            <Image src={check} alt="Check" class="w-5 h-5 flex-shrink-0" />
            <span class="text-sm text-black font-medium">Sin trámites complicados</span>
          </div>
        </div>

        <!-- Botones móvil -->
        <div class="flex flex-col gap-3" style="margin-top: 200px;">
          <a
            href={whatsappLinks.cotizarSeguroVida}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full px-6 py-3 bg-servir-green text-black font-bold rounded-2xl hover:opacity-90 transition text-base"
          >
            Cotizar mi seguro de vida ahora
          </a>
          <a
            href={whatsappLinks.hablarConAsesor}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block w-full px-6 py-3 bg-gray-200 text-black font-bold rounded-2xl hover:bg-gray-300 transition text-base"
          >
            Hablar con un asesor
          </a>
        </div>
      </div>

      <!-- Desktop: diseño mejorado -->
      <div class="hidden sm:block">
        <h2 class="text-3xl lg:text-4xl xl:text-4xl font-bold mb-6 leading-tight title">
          <span class="text-[#0B2D49]">Comprar</span> <span class="text-[#4B88B7]">un seguro de vida,</span><br />
          <span class="text-[#4B88B7]">es regalar protección y</span><br />
          <span class="text-[#4B88B7]">tranquilidad</span> <span class="text-[#0B2D49]">a tu familia</span>
        </h2>

        <p class="text-lg lg:text-xl leading-relaxed mb-6 text-black font-semibold">
          Que pase lo que pase, estará protegida<br />
          y respaldada si algún día tú faltas.
        </p>

        <!-- Lista con checks -->
        <div class="mb-8 space-y-3">
          <div class="flex items-center gap-3">
            <Image src={check} alt="Check" class="w-6 h-6 flex-shrink-0" />
            <span class="text-base lg:text-lg text-black font-medium">Fácil y rápido online</span>
          </div>
          <div class="flex items-center gap-3">
           <Image src={check} alt="Check" class="w-6 h-6 flex-shrink-0" />
            <span class="text-base lg:text-lg text-black font-medium">Planes pensados en familias</span>
          </div>
          <div class="flex items-center gap-3">
            <Image src={check} alt="Check" class="w-6 h-6 flex-shrink-0" />
            <span class="text-base lg:text-lg text-black font-medium">Sin trámites complicados</span>
          </div>
        </div>

        <!-- Botones desktop -->
        <div class="flex flex-wrap gap-4">
          <a
            href={whatsappLinks.cotizarSeguroVida}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-3 bg-servir-green text-black font-bold rounded-2xl hover:opacity-90 transition text-base lg:text-lg"
          >
            Cotizar mi seguro de vida ahora
          </a>
          <a
            href={whatsappLinks.hablarConAsesor}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block px-8 py-3 bg-gray-200 text-black font-bold rounded-2xl hover:bg-gray-300 transition text-base lg:text-lg"
          >
            Hablar con un asesor
          </a>
        </div>
      </div>
    </div>    
  </div>
</section>