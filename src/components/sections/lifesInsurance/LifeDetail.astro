---
import { Image } from "astro:assets";
import BenefitItem from "../../ui/BenefitItem.astro";

// Imagen del título
import tituloImg from "../../../assets/images/lifeInsurance/seguro-titulo.webp";

// Iconos
import icon1 from "../../../assets/iconos/lifeInsurance/proteccion-economica.svg";
import icon2 from "../../../assets/iconos/lifeInsurance/respaldo-invalidez.svg";
import icon3 from "../../../assets/iconos/lifeInsurance/cobertura-deudas.svg";
import icon4 from "../../../assets/iconos/lifeInsurance/futuro-seguro.svg";
import { whatsappLinks } from "../../../utils/whatsapp";

---

<section
  class="w-full flex flex-col items-center justify-center text-center px-6 py-10 md:py-16 bg-white"
>
  <!-- Imagen del título -->
  <div class="mb-12">
    <Image
      src={tituloImg}
      alt="Una póliza de salud te brinda"
      class="mx-auto w-[400px] md:w-[520px]"
    />
  </div>

  <!-- Beneficios -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl mb-10">
    <BenefitItem
      icon={icon1}
      alt="protección económica"
      text={`Protección ecónomica para tu
      familia en caso de fallecimiento.`}
      showBorder={true}
    />

    <BenefitItem
      icon={icon3}
      alt="cobertura deudas"
      text={`Cobertura de deudas
      o créditos.`}
      showBorder={true}
    />

    <BenefitItem
      icon={icon2}
      alt="respaldo invalidez"
      text={`Respaldo en caso de invalidez o
      enfermedades graves.`}
      showBorderMobileOnly={true}
    />

    <BenefitItem
      icon={icon4}
      alt="futuro seguro"
      text={`Futuro seguro para tus hijos 
      o dependientes.`}
    
    />
  </div>

  <!-- Botón Cotizar -->
  <a href={whatsappLinks.cotizarSeguroVida} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green transition mb-12">
    Cotizar seguro
  </a>


  <!-- Pasos -->
  <div class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative">
    <!-- Paso 1 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Cotiza tu seguro en minutos.</p>
    </div>

    <!-- Paso 2 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Elige el plan ideal para ti y tu familia.</p>
    </div>

    <!-- Paso 3 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Vive con tranquilidad.</p>
    </div>
  </div>


  <!-- Segundo botón -->
  <a href={whatsappLinks.cotizarSeguroVida} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green">
    Cotizar seguro
  </a>
</section>
