---
import { Image } from "astro:assets";
import detailBg from "../../../assets/images/lifeInsurance/Health-detail.webp";
import detailBgMobile from "../../../assets/images/lifeInsurance/Health-detail-mobile.webp";
---

<section
  class="relative bg-cover bg-center bg-no-repeat text-white overflow-hidden flex flex-col items-center justify-center text-center h-[470px] md:h-[650px] m-0 p-0 md:h-auto md:px-6 md:py-36"
>
  <!-- Imagen de fondo: Desktop y Mobile -->
  <!-- Desktop -->
  <div class="hidden md:flex absolute inset-0 items-center justify-center">
  <Image
    src={detailBg}
    alt="Fondo salud detalle"
    class="absolute w-full max-w-3xl lg:max-w-4xl xl:max-w-5xl h-auto object-contain"
  />
  </div>
<!-- Mobile -->
<div
  class="md:hidden absolute inset-0 p-4 pt-10 pb-10"
>
  <Image
    src={detailBgMobile}
    alt="Fondo salud detalle móvil"
    class="w-full h-full object-cover rounded-[40px]"
  />
</div>

<!-- Contenido -->
<div
  class="relative z-10 w-full max-w-4xl mx-auto flex flex-col items-center justify-center px-4 md:px-6"
>
  <!-- Título con fondo oscuro -->
  <div
    class="bg-[#1E4760] px-6 py-2 md:py-3 rounded-xl md:rounded-2xl mb-4 md:mb-5"
  >
    <h2
      class="text-base md:text-xl lg:text-2xl font-bold text-white whitespace-nowrap"
    >
      La vida es incierta
    </h2>
  </div>

  <!-- Pregunta principal -->
  <h1
    class="text-2xl md:text-4xl lg:text-4xl xl:text-5xl font-bold text-center text-white mb-4 md:mb-6 leading-tight"
  >
    ¿Qué pasaría con tu familia<br />
    si mañana ya no estás?
  </h1>

  <!-- Subtítulo -->
  <p
    class="text-sm md:text-base lg:text-lg xl:text-xl font-medium text-center text-[#0B2D49] md:text-[#0B2D49] mb-5 md:mb-6 leading-relaxed"
  >
    Un accidente o una enfermedad inesperada<br />
    pueden cambiarlo todo en segundos.
  </p>

  <!-- Caja blanca con mensaje final -->
  <div
    class="bg-white text-[#0B2D49] font-bold rounded-xl md:rounded-2xl px-3 md:px-18 py-4 md:py-3 shadow-lg max-w-[85%] md:max-w-2xl"
  >
    <p
      class="text-sm md:text-lg lg:text-xl xl:text-2xl text-center leading-snug md:leading-relaxed"
    >
      Sin un respaldo, tu familia podría<br />
      enfrentar deudas, gastos diarios y un<br />
      futuro incierto sin ti.
    </p>
  </div>
</div>
</section>