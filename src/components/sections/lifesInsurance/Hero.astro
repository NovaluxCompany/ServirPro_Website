---
import { Image } from "astro:assets";
import heroBg from "../../../assets/images/lifeInsurance/Hero.webp";
import heroBgMobile from "../../../assets/images/lifeInsurance/Hero-mobile.webp";
import check from "../../../assets/iconos/lifeInsurance/Check-green.svg";

const policyTitle = "Proteje el futuro";
const policyTitle2 = "de tu familia,";
const policyTitle3 = "Pase lo que pase.";
const description = "Un seguro de vida que garantiza";
const description2 = "y tranquilidad";
const description3 = "para quienes más amas, incluso si tú no estás.";
const subtitle = "Planes accesibles y coberturas flexibles";
const subtitle2 = "según tu necesidad y presupuesto.";
const buttonText = "Cotizar mi seguro de vida";
const subtitle3 = "Cotización gratuita sin compromiso";

import { whatsappLinks } from "../../../utils/whatsapp";
---

<section class="h-[70vh] max-h-[70vh] sm:h-auto sm:max-h-none">
  <div class="w-full h-full">
    <div
      class="relative overflow-hidden h-full sm:min-h-[500px] md:min-h-[580px] lg:min-h-[650px]"
    >
      <!-- Imagen de fondo usando el componente Image -->
      <!-- Desktop y Tablet -->
      <Image
        src={heroBg}
        alt="Pólizas de salud"
        class="absolute inset-0 w-full h-full object-cover hidden sm:block"
      />
      <!-- Mobile -->
      <Image
        src={heroBgMobile}
        alt="Pólizas de salud mobile"
        class="absolute inset-0 w-full h-[80vh] border-none object-cover sm:hidden"
      />

      <!-- Contenedor para tablet y desktop -->
      <div
        class="hidden sm:block absolute top-8 sm:top-10 md:top-12 lg:top-16 right-0 w-[50%] lg:w-[45%]"
      >
        <div class="px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16">
          <h2
            class="text-2xl title font-extrabold text-[#21608D] leading-tight max-w-62 md:max-w-90"
          >
            {policyTitle}<br />
            {policyTitle2}<br />{policyTitle3}
          </h2>
        </div>
      </div>

      <div class="absolute inset-0 bg-opacity-20 sm:hidden"></div>

      <div class="hidden sm:block">
        <!-- Contenido posicionado debajo de la banda, centrado respecto a ella -->
        <div
          class="relative sm:absolute sm:right-0 sm:top-0 sm:bottom-0 sm:w-[50%] lg:w-[45%] flex items-center sm:items-start md:items-center pt-12"
        >
          <div class="px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16">
            <div class="text-left w-full">
              <p class="mb-2 md:mb-4 mt-16 sm:mt-38 md:mt-16 lg:mt-16 xl:mt-16">
                <span
                  class="text-base sm:text-lg md:text-xl lg:text-xl font-medium text-black leading-snug"
                >
                  {description}<br /><span class="font-bold"
                    >respaldo económico
                  </span>{description2}<br />{description3}
                </span>
              </p>

              <p>
                <span
                  class="text-base sm:text-lg md:text-xl lg:text-xl font-normal text-black leading-snug"
                >
                  {subtitle}<br />{subtitle2}
                </span>
              </p>

              <a
                href={whatsappLinks.cotizarSeguroVida}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block w-100 mt-4 sm:mt-6 md:mt-8 px-6 sm:px-8 py-2 sm:py-3 text-sm text-center sm:text-base md:text-lg font-bold text-black bg-servir-green rounded-2xl shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl btn-text"
                style="margin-top: 12px;"
              >
                {buttonText}
              </a>

              <div class="flex items-center gap-2 mt-4">
                <Image src={check} alt="Check" class="w-5 h-5 sm:w-6 sm:h-6" />
                <span
                  class="text-base sm:text-lg md:text-xl lg:text-lg font-normal text-black leading-snug"
                >
                  {subtitle3}
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Contenedor para móvil -->
      <div class="sm:hidden absolute inset-0 flex items-start justify-start">
        <div
          class="w-full p-2 bg-transparent mt-[55%] z-10 pb-8"
          style="
    padding-left: 30px;
    padding-right: 40px;"
        >
          <div class="text-left w-full mb-3">
            <!-- Título -->
            <h2 class="text-2xl font-extrabold text-[#21608D] leading-tight">
              {policyTitle}<br />
              {policyTitle2}<br />
              {policyTitle3}
            </h2>

            <!-- Descripción -->
            <p class="leading-tight mb-1">
              <span class="text-sm font-medium text-black leading-tight">
                {description}<br />
                <span class="font-bold">respaldo económico</span>
                {description2}<br />
                {description3}
              </span>
            </p>

            <!-- Subtítulo -->
            <p class="leading-none mb-2">
              <span class="text-xs font-normal text-black leading-none">
                {subtitle}
                {subtitle2}
              </span>
            </p>

            <!-- Botón -->
            <a
              href={whatsappLinks.cotizarSeguroVida}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block px-4 py-3 text-sm font-bold text-black bg-servir-green w-full rounded-2xl shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl mb-2 text-center"
            >
              {buttonText}
            </a>

            <!-- Check con texto -->
            <div class="flex items-center gap-2">
              <Image src={check} alt="Check" class="w-4 h-4 flex-shrink-0" />
              <span class="text-xs font-normal text-black leading-tight">
                {subtitle3}
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
