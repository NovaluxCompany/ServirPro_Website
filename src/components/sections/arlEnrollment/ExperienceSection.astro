---
import { Image } from "astro:assets";
import icon from "../../../assets/iconos/aditionalServices/servicies2.svg";

const title = "Más de 10 años asesorando trabajadores y empresas";
const text = "Atención personalizada y oficinas físicas en Medellín, Bogotá, Pereira y Cali.";
---

<section class="w-full bg-white py-14 px-4">
  <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
    <Image src={icon} alt="Icono de experiencia" class="w-16 h-16 md:w-20 md:h-20 mb-6" />
    <h2 class="title text-2xl md:text-4xl font-bold text-servir-gray-dark mb-4">
      {title}
    </h2>
    <p class="subtitle text-servir-gray text-lg md:text-xl font-medium">
      {text}
    </p>
  </div>
</section>
