---
import { Image } from "astro:assets";
import detailBg from "../../../assets/images/arlEnrollment/Health-detail.webp";
import detailBgMobile from "../../../assets/images/arlEnrollment/Health-detail-mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";

const mainTitle = "Resuelve tus dudas sobre EPS fácil y rápido";
const description = "Cuéntanos tu situación y recibe orientación personalizada para entender tus opciones y los pasos que debes tener en cuenta.";
const buttonText = "Quiero recibir asesoría";
---

<section class="relative w-full min-h-[500px] md:min-h-[600px] overflow-hidden bg-white py-8 px-4 md:py-12 md:px-18">
  <!-- Imagen de fondo -->
  <div class="absolute inset-0 m-4 md:m-16 rounded-3xl md:rounded-[40px] overflow-hidden">
    <Image
      src={detailBg}
      alt="Fondo salud detalle"
      class="hidden md:block w-full h-full object-cover"
    />
    <Image
      src={detailBgMobile}
      alt="Fondo salud detalle móvil"
      class="md:hidden w-full h-full object-cover"
    />
  </div>

  <!-- Contenido -->
  <div class="relative z-10 flex items-center justify-center min-h-[500px] md:min-h-[600px] px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto text-center space-y-6 md:space-y-8">
      
      <!-- Título principal -->
      <h2 class="text-white text-4xl md:text-5xl lg:text-6xl font-bold leading-tight title">
        {mainTitle}
      </h2>

      <!-- Descripción -->
      <p class="text-servir-gray-dark text-lg md:text-xl lg:text-2xl font-medium max-w-3xl mx-auto subtitle">
        {description}
      </p>

      <!-- Botón CTA -->
      <a
        href={whatsappLinks.cotizarEps}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-8 py-4 text-lg md:text-xl font-bold text-black bg-servir-green rounded-full shadow-lg transition-all duration-300 hover:bg-opacity-90 hover:shadow-xl hover:scale-105 text-center button-text"
      >
        {buttonText}
      </a>

    </div>
  </div>
</section>
