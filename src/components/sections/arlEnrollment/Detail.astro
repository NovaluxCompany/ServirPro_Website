---
import { Image } from "astro:assets";
import BenefitItem from "../../ui/BenefitItem.astro";
import { whatsappLinks } from "../../../utils/whatsapp";

// Imagen del título
import tituloImg from "../../../assets/images/arlEnrollment/afiliacion-titulo.webp";

// Iconos
import icon1 from "../../../assets/iconos/arlEnrollment/icon1.svg";
import icon2 from "../../../assets/iconos/arlEnrollment/icon2.svg";
import icon3 from "../../../assets/iconos/arlEnrollment/icon3.svg";
import icon4 from "../../../assets/iconos/arlEnrollment/icon4.svg";
import icon5 from "../../../assets/iconos/arlEnrollment/icon5.svg";
import icon6 from "../../../assets/iconos/arlEnrollment/icon6.svg";
---

<section
  class="w-full flex flex-col items-center justify-center text-center px-6 py-10 md:py-16 bg-white"
>
  <!-- Imagen del título -->
  <div class="mb-4">
    <Image
      src={tituloImg}
      alt="Una póliza de salud te brinda"
      class="mx-auto w-[400px] md:w-[680px]"
    />
  </div>

  <p class="text-center subtitle mb-12 text-servir-blue">
    Tramita tu afiliación a EPS de forma correcta, rápida y sin contratiempos
  </p>

  <!-- Beneficios -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl mb-10">
    <BenefitItem
      icon={icon1}
      alt="icon1"
      text={`Evita rechazos
       y bloqueos en la afiliación.`}
      showBorder={false}
    />

    <BenefitItem
      icon={icon2}
      alt="icon2"
      text={`Acompañamiento real por WhatsApp durante todo el proceso`}
      showBorder={false}
    />

    <BenefitItem
      icon={icon3}
      alt="icon3"
      text={`Activación rápida
      sin trámites ni filas.`}
      showBorder={false}
    />

    <BenefitItem
      icon={icon4}
      alt="icon4"
      text={`Orientación para elegir la EPS
       adecuada según tu caso`}
      showBorderMobileOnly={false}
    />
    <BenefitItem
      icon={icon5}
      alt="icon5"
      text={`Corrección de datos y
       verificación antes del envío`}
      showBorder={false}
    />
    <BenefitItem
      icon={icon6}
      alt="icon6"
      text={`+10 años afiliando trabajadores
      y empresas en todo el país`}
      showBorder={false}
    />
  </div>
</section>
<section
  class="w-full flex flex-col items-center justify-center text-center px-6 py-16 md:py-16 bg-[#f3f3f3]"
>
  <!-- Pasos -->
  <div>
    <h2 class="text-lg subtitle text-center font-bold text-servir-blue">
      Así de fácil es activar tu afiliación
    </h2>

    <div
      class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative bg-gray"
    >
      <!-- Paso 1 -->
      <div
        class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
      >
        <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
        <p class="font-medium text-servir-dark-text step-text description">
          Envías tus datos y documentos básicos.
        </p>
      </div>
      <!-- Paso 2 -->
      <div
        class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
      >
        <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
        <p class="font-medium text-servir-dark-text step-text description">
          Nosotros nos encargamos de todo el trámite.
        </p>
      </div>

      <!-- Paso 3 -->
      <div
        class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
      >
        <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
        <p class="font-medium text-servir-dark-text step-text description">
          Tu afiliación se activa en poco tiempo.
        </p>
      </div>
    </div>
  </div>

  <!-- Segundo botón -->
  <a
    href={whatsappLinks.cotizarEps}
    target="_blank"
    rel="noopener noreferrer"
    class="button-text button-container bg-servir-green cursor-pointer md:w-[350px] text-[#000] font-bold px-8 py-3 mb-7 rounded-full hover:bg-servir-green"
  >
    Afiliarme a la EPS ahora
  </a>
</section>
