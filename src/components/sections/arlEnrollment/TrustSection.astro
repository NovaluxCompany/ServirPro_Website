---
import { Image } from "astro:assets";
import icon from "../../../assets/iconos/arlEnrollment/icon3.svg";
import { whatsappLinks } from "../../../utils/whatsapp";

const title = "Asesoría personalizada cuando la necesitas";
const text = "Resuelve tus inquietudes con un equipo con experiencia en Seguridad Social y recibe información clara para tomar decisiones sobre tu proceso.";
const buttonText = "Hablar con un asesor";
---

<section class="w-full bg-gray-100 py-14 px-4">
  <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
    <Image src={icon} alt="Icono de asesoría personalizada" class="w-14 h-14 md:w-16 md:h-16 mb-6" />
    <h2 class="title text-2xl md:text-4xl font-bold text-servir-gray-dark mb-4">
      {title}
    </h2>
    <p class="subtitle text-servir-gray text-lg md:text-xl font-medium mb-8">
      {text}
    </p>
    <a
      href={whatsappLinks.cotizarEps}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-8 py-4 text-lg md:text-xl font-bold text-black bg-servir-green rounded-full shadow-lg transition-all duration-300 hover:bg-opacity-90 hover:shadow-xl hover:scale-105 text-center button-text"
    >
      {buttonText}
    </a>
  </div>
</section>
