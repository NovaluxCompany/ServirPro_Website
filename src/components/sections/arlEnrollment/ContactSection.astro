---
// ContactSection.astro - Sección de contacto con imagen de doctor
import { Image } from "astro:assets";
import contactWebImage from "../../../assets/images/arlEnrollment/CTAfinal.webp";
import contactMobileImage from "../../../assets/images/arlEnrollment/CTAfinal-mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<!-- Sección de Contacto -->
<section
    class="relative py-0 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden min-h-[600px] md:min-h-[670px]"
>
    <!-- Imagen de fondo para desktop -->
    <Image
        src={contactWebImage}
        alt="Contacto ServirPRO"
        class="absolute inset-0 w-full h-full object-cover z-0 hidden sm:block"
        loading="lazy"
        quality={90}
    />

    <!-- Imagen de fondo para mobile -->
    <Image
        src={contactMobileImage}
        alt="Contacto ServirPRO mobile"
        class="absolute inset-0 w-full h-full object-cover object-top z-0 sm:hidden"
        loading="lazy"
        quality={90}
    />

    <!-- Contenido -->
    <div
        class="relative z-10 max-w-7xl mx-auto px-6 sm:px-6 lg:px-8 h-full flex flex-col justify-between sm:justify-center min-h-[600px] md:min-h-[500px] pt-12 pb-12 sm:pt-0 sm:pb-0"
    >
        <div class="max-w-2xl text-left sm:text-left">
            <!-- Título principal -->
            <h2
                class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#003366] mb-2 leading-tight"
            >
                Tu salud no puede <br /> esperar
            </h2>

            <!-- Subtítulo -->
            <p class="text-xl md:text-2xl text-servir-blue font-medium mb-6">
                Nosotros nos encargamos <br class="sm:hidden" /> de todo por ti
            </p>

            <!-- Texto descriptivo -->
            <p
                class="text-base md:text-lg text-gray-800 mb-8 max-w-xl leading-relaxed font-medium"
            >
                Afiliarte correctamente te da tranquilidad, atención médica
                garantizada y respaldo en cualquier momento. Solo necesitas dar
                el primer paso.
            </p>
        </div>

        <!-- Botones -->
        <div
            class="flex flex-col sm:flex-row gap-4 justify-start items-start w-full sm:w-auto sm:mt-8"
        >
            <a
                href={whatsappLinks.cotizarEps}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-servir-green text-black min-w-64 sm:w-min md:w-72 font-bold py-3 px-8 rounded-lg hover:opacity-90 transition-opacity text-center shadow-md button-text"
            >
                Afiliarme a la EPS
            </a>
            <a
                href={whatsappLinks.hablarConAsesor}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-gray-200 text-black min-w-67 sm:w-min md:w-86 font-bold py-3 px-8 rounded-lg hover:bg-gray-300 transition-colors text-center shadow-md button-text"
            >
                Hablar con un asesor
            </a>
        </div>
    </div>
</section>
