---
import { Image } from 'astro:assets';
import heroBg from '../../../assets/images/arlEnrollment/Hero.webp';
import heroBgMobile from '../../../assets/images/arlEnrollment/Hero-mobile.webp';
 import { whatsappLinks } from "../../../utils/whatsapp";

const policyTitle = "Afiliaciones a solo EPS";
const subtitle = "Accede fácil y rápido";
const description = " a tu servicio de salud con respaldo de ServirPRO Seguros.";
const buttonText = "Afiliarme ahora";
---

<section class="h-[70vh] max-h-[70vh] sm:h-auto sm:max-h-none">
  <div class="w-full h-full">
    <div 
      class="relative overflow-hidden  h-full sm:min-h-[500px] md:min-h-[580px] lg:min-h-[650px]"
    >
      <!-- Imagen de fondo usando el componente Image -->
      <!-- Desktop y Tablet -->
      <Image src={heroBg} alt="Pólizas de salud" class="absolute inset-0 w-full h-full object-cover hidden sm:block" />
      <!-- Mobile -->
      <Image src={heroBgMobile} alt="Pólizas de salud mobile" class="absolute inset-0 w-full h-[80vh] border-none object-cover sm:hidden" />
      
      <!-- Banda de título en tablet y desktop: fija a la derecha -->
      <div id="title-band" class="hidden sm:block absolute top-36 md:top-36 lg:top-36 right-0 w-[45%] md:w-[40%] bg-servir-blue-dark rounded-l-full rounded-r-none shadow-md z-10 py-3 md:py-4 px-4 md:px-6 title">
        <h2 class="font-extrabold text-white leading-tight text-center text-3xl md:text-4xl lg:text-5xl title">{policyTitle}</h2>
      </div>
      
      <div class="absolute inset-0 bg-opacity-20 sm:hidden"></div>
      
      <!-- Contenedor para móvil -->
      <div class="sm:hidden absolute inset-0 flex items-center justify-center p-5">
        <div class="w-full max-w-lg p-6 bg-transparent mt-[70%] z-10">
          <div class="text-center w-full">
            <!-- Título en móvil: caja azul pequeña centrada -->
            <div class="inline-block p-2 mb-5 rounded-lg bg-servir-blue-dark shadow-md">
              <h2 class="text-3xl font-extrabold text-white leading-tight">
                {policyTitle}
              </h2>
            </div>

            <p  class="mb-16">
              <span class="text-lg  text-[#5793ce] leading-snug " style="font-weight:800">{subtitle}</span>
              <span class="text-lg  font-bold text-servir-blue-dark  " style="font-weight:600">
              {description}
            </span>
            </p>
            
    

            <a href={whatsappLinks.cotizarEps} target="_blank" rel="noopener noreferrer" class="button-text button-container inline-block px-6 py-3 text-sm font-bold text-black bg-servir-green w-100 rounded-full shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl" style="width:100%">
              {buttonText}
            </a>
          </div>
        </div>
      </div>

      <!-- Contenedor para tablet y desktop -->
      <div class="hidden sm:block">
        <!-- Contenido posicionado debajo de la banda, centrado respecto a ella -->
        <div class="absolute right-0 w-[45%] md:w-[40%] z-10 sm:top-[200px] md:top-[220px] lg:top-[230px]">
          <div class=" md:p-6 lg:p-8">
            <div class="text-center w-full">
              <p class="mb-6 md:mb-8">
                <span class="text-lg sm:text-xl md:text-2xl lg:text-3xl leading-snug text-[#5793ce] font-extrabold subtitle ">
                  {subtitle}
                </span>
                
                <span class="text-base sm:text-lg md:text-2xl lg:text-3xl text-servir-blue-dark font-semibold subtitle">
                  {description}
                </span>
              </p>

              <a href={whatsappLinks.cotizarEps} target="_blank" rel="noopener noreferrer" class="button-text inline-block w-100  mt-4 sm:mt-6 md:mt-8 px-6 sm:px-8 py-2 sm:py-3 text-sm sm:text-base md:text-lg font-bold text-black bg-servir-green rounded-full shadow-lg transition duration-300 ease-in-out hover:bg-servir-green hover:shadow-xl">
                {buttonText}
              </a>
            </div>
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>