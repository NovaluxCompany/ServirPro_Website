---
import { Image } from "astro:assets";
import detailBg from "../../../assets/images/healthEnrollment/detailArl.webp";
import detailBgMobile from "../../../assets/images/healthEnrollment/detail-mobile.webp";
import checkIcon from "../../../assets/iconos/healthEnrollment/check.svg";
import { whatsappLinks } from "../../../utils/whatsapp";

const features = [
  "Construcción",
  "Aseo",
  "Mensajería",
  "Mantenimiento",
  "Enfermería",
  "Servicios eléctricos",
  "Oficios varios",
];
---

<section
  class="relative overflow-hidden flex items-center justify-center py-10 md:py-20 min-h-[800px] md:min-h-[900px]"
>
  <!-- Fondo Desktop -->
  <div class="absolute inset-0 flex items-center justify-center hidden md:flex">
    <Image
      src={detailBg}
      alt="Fondo"
      class="w-full max-w-3xl lg:max-w-4xl xl:max-w-5xl h-auto object-contain"
    />
  </div>

  <!-- Fondo Mobile -->
  <div
    class="md:hidden absolute inset-0 p-4"
    style="
    padding-top: 40px;
    padding-bottom: 40px;"
  >
    <Image
      src={detailBgMobile}
      alt="Fondo móvil"
      class="w-full h-full object-cover rounded-[40px]"
    />
  </div>

  <!-- Contenido -->
  <div class="absolute z-10 max-w-5xl w-full px-8 py-6 md:px-12 md:py-0">
    <!-- TITULAR PRINCIPAL -->
    <h2
      class="text-xl sm:text-2xl md:text-3xl font-bold text-white text-left md:text-center leading-snug mb-4 md:mb-8"
    >
      ¿Trabajas como independiente <br class="hidden md:block" />
      y necesitas ARL?
    </h2>

    <!-- MOBILE: Lista primero -->
    <ul class="md:hidden space-y-1.5 mb-6">
      {
        features.map((feature) => (
          <li class="flex items-center gap-2.5">
            <img
              src={checkIcon.src}
              alt="Check"
              class="w-4 h-4 flex-shrink-0"
            />
            <span class="text-white text-sm font-medium leading-snug">
              {feature}
            </span>
          </li>
        ))
      }
    </ul>

    <!-- MOBILE: Texto después de la lista -->
    <p
      class="md:hidden text-base text-[#0B2E4A] justify-center font-semibold leading-relaxed mb-6"
    >
      Te orientamos sobre los requisitos que debes tener en cuenta según tu
      actividad y el trabajo que vas a realizar.
    </p>

    <!-- DESKTOP: Flex con texto izquierda y lista derecha -->
    <div class="hidden md:flex flex-row justify-center gap-8">
      <!-- TEXTO IZQUIERDA -->
      <p
        class="text-xl lg:text-2xl text-[#0B2E4A] font-semibold leading-relaxed max-w-[45%]"
        style="padding-top: 79px"
      >
        Te orientamos sobre los requisitos que debes tener en cuenta según tu
        actividad y el trabajo que vas a realizar.
      </p>

      <!-- LISTA DERECHA -->
      <ul class="space-y-2.5">
        {
          features.map((feature) => (
            <li class="flex items-center gap-3">
              <img
                src={checkIcon.src}
                alt="Check"
                class="w-5 h-5 flex-shrink-0"
              />
              <span class="text-white text-lg font-medium leading-snug">
                {feature}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- CAJA BLANCA FINAL -->
    <div
      class="bg-white text-[#1e3a5f] rounded-2xl shadow-md py-5 px-5 md:py-6 md:px-10 mt-6 md:mt-10 text-left md:text-center mx-auto md:max-w-2xl"
    >
      <p class="text-base md:text-xl font-bold leading-snug mb-4">
        ¿Te solicitaron ARL para iniciar un trabajo o ingresar a una obra?
        Habla con uno de nuestros asesores.
      </p>
      <a
        href={whatsappLinks.cotizarArl}
        target="_blank"
        rel="noopener noreferrer"
        class="button-text button-container inline-block bg-servir-green cursor-pointer text-[#000] font-bold px-8 py-3 rounded-xl hover:bg-servir-green transition"
      >
        Consultar mi caso
      </a>
    </div>
  </div>
</section>
