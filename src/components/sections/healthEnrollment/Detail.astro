---
import BenefitItem from "../../ui/BenefitItem.astro";
import { whatsappLinks } from "../../../utils/whatsapp";

// Iconos
import icon1 from "../../../assets/iconos/healthEnrollment/icon1.webp";
import icon2 from "../../../assets/iconos/healthEnrollment/icon2.webp";
import icon3 from "../../../assets/iconos/healthEnrollment/icon3.webp";
import icon4 from "../../../assets/iconos/healthEnrollment/icon4.webp";
---

<section
  class="w-full flex flex-col items-center justify-center text-center text-black px-6 py-10 md:py-16 bg-white"
>
  <h2 class="title text-2xl md:text-4xl font-extrabold text-servir-blue-dark mb-4 max-w-2xl">
    ¿Por qué es importante contar con ARL?
  </h2>

  <p class="subtitle mb-8 text-servir-blue max-w-2xl">
    La ARL brinda protección frente a accidentes y riesgos laborales de
    acuerdo con las condiciones y coberturas aplicables.
  </p>

  <!-- Beneficios -->
  <div class="space-y-1 sm:space-y-2.5 md:space-y-1 mb-10">
    <BenefitItem
      icon={icon1}
      alt="Atención ante accidentes laborales"
      text={`Atención ante accidentes laborales según la cobertura aplicable.`}
      showBorder={false}
    />

    <BenefitItem
      icon={icon2}
      alt="Prestaciones económicas"
      text={`Prestaciones económicas cuando correspondan según la normatividad.`}
      showBorder={false}
    />

    <BenefitItem
      icon={icon3}
      alt="Rehabilitación y atención"
      text={`Rehabilitación y atención derivadas de accidentes o enfermedades laborales, cuando aplique.`}
      showBorderMobileOnly={false}
    />

    <BenefitItem
      icon={icon4}
      alt="Cumplimiento de requisitos de Seguridad Social"
      text={`Cumplimiento de requisitos de Seguridad Social cuando sean exigibles para tu actividad.`}
    />
  </div>

  <p class="text-base md:text-lg font-medium text-black leading-snug mb-5 max-w-2xl">
    Si tienes dudas sobre la ARL que necesitas para tu actividad, recibe
    orientación personalizada.
  </p>

  <!-- Botón -->
  <a
    href={whatsappLinks.cotizarArl}
    target="_blank"
    rel="noopener noreferrer"
    class="button-text button-container bg-servir-green cursor-pointer md:w-[400px] text-[#000] font-bold px-8 py-3 rounded-xl hover:bg-servir-green transition"
  >
    Hablar con un asesor
  </a>
</section>

<section
  class="w-full flex flex-col items-center justify-center text-center px-6 py-10 md:py-16 bg-[#e6e6e6]"
  style="padding-bottom: 100px;"
>
  <div class="ditext-center md:mb-16v">
    <h2
      class="font-extrabold text-[#2b89c6] text-xl sm:text-2xl md:text-3xl lg:text-4xl leading-tight font-weight:normal mt-2 title"
    >
      ¿Necesitas afiliarte a una ARL <br />y no sabes cómo empezar?
    </h2>
    <p class="subtitle text-servir-blue mt-4 max-w-2xl mx-auto">
      Te orientamos paso a paso para que conozcas qué debes tener en cuenta.
    </p>
  </div>
  <!-- Pasos -->
  <div
    class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative"
  >
    <!-- Paso 1 -->
    <div
      class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
    >
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
      <p class="font-bold text-black step-text description">
        Cuéntanos tu caso
      </p>
      <p class="font-medium text-black step-text description">
        Indícanos la actividad o trabajo que vas a realizar y las dudas que
        tienes.
      </p>
    </div>

    <!-- Paso 2 -->
    <div
      class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
    >
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
      <p class="font-bold text-black step-text description">
        Recibe asesoría personalizada
      </p>
      <p class="font-medium text-black step-text description">
        Uno de nuestros asesores revisa tu consulta y te orienta sobre los
        requisitos y aspectos que debes conocer.
      </p>
    </div>

    <!-- Paso 3 -->
    <div
      class="relative bg-white rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6"
    >
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
      <p class="font-bold text-black step-text description">
        Conoce cómo continuar
      </p>
      <p class="font-medium text-black step-text description">
        Recibe orientación clara sobre los siguientes pasos de acuerdo con tu
        situación.
      </p>
    </div>
  </div>

  <!-- Segundo botón -->
  <a
    href={whatsappLinks.cotizarArl}
    target="_blank"
    rel="noopener noreferrer"
    class="button-text button-container bg-servir-green cursor-pointer md:w-[400px] text-[#000] font-bold px-8 py-3 rounded-xl hover:bg-servir-green"
  >
    Recibir asesoría por WhatsApp
  </a>
</section>
