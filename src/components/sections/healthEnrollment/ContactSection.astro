---
// FamilySection.astro - Sección de tranquilidad con imagen de familia
import { Image } from "astro:assets";
import contactWebImage from "../../../assets/images/healthEnrollment/ContactBanner.webp";
import contactMobileImage from "../../../assets/images/healthEnrollment/ContactBanner-mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<!-- Sección de Tranquilidad con Imagen de Familia -->
<section
    class="relative py-0 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden max-h-[600px] md:min-h-[670px]"
>
    <!-- Imagen de fondo para desktop -->
    <Image
        src={contactWebImage}
        alt="Contacto ServirPRO"
        class="absolute inset-0 w-full h-full object-cover z-0 hidden sm:block"
        loading="lazy"
        quality={90}
    />

    <!-- Imagen de fondo para mobile -->
    <Image
        src={contactMobileImage}
        alt="Contacto ServirPRO mobile"
        class="absolute inset-0 w-full h-full object-cover object-top z-0 sm:hidden"
        loading="lazy"
        quality={90}
    />

    <!-- Contenido -->
<!-- Contenido -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full min-h-[620px] sm:min-h-full md:min-h-full flex flex-col justify-end py-8 sm:py-0">
        <div class="sm:mx-0 sm:max-w-xl lg:max-w-2xl text-left"style="margin-bottom: 50px;">
            <!-- Título -->
            <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-[#0B2D49] font-bold mb-4 sm:mb-6 leading-tight">
                Tu tranquilidad <br />no tiene precio.
            </h2>
            <!-- Subtítulo -->
            <p class="text-xl md:text-2xl text-black font-medium mb-6">
                <span>Un accidente de trabajo puede <br />
                cambiarlo todo en un instante.</span>
            </p>
        <!-- Descripción -->
            <p class="text-lg sm:text-xl lg:text-2xl text-black mb-8 lg:mb-10 leading-relaxed font-medium text-left">
                <span class="font-bold">Afíliate con ServirPRO Seguros </span> y <br class="hidden sm:block" />recibe respaldo inmediato para
                <br class="hidden sm:block" />trabajar con seguridad.
            </p> 
        </div>

        <!-- Botones (mobile: flujo normal; desktop: overlay inferior con espaciado) -->
        <!-- Mobile -->
        <div class="flex flex-col gap-3 pt-6 pb-8 justify-center items-center w-full sm:hidden">
            <a href={whatsappLinks.cotizarARL} target="_blank" rel="noopener noreferrer" class="bg-servir-green text-black min-w-64 sm:w-min md:w-72 font-bold py-3 px-8 rounded-2xl hover:opacity-90 transition-opacity text-center shadow-md">
                Afiliarme a la EPS
            </a>
            <a href={whatsappLinks.hablarConAsesor} target="_blank" rel="noopener noreferrer" class="bg-gray-200 text-black min-w-64 sm:w-min md:w-72 font-bold py-3 px-8 rounded-2xl hover:bg-gray-300 transition-colors text-center shadow-md">
                Hablar con un asesor
            </a>
        </div>

    </div>
    <!-- Desktop overlay (posicionado hacia la parte inferior de la imagen) -->
    <div class="hidden sm:flex gap-4 justify-start items-start w-full sm:absolute sm:inset-x-0 sm:bottom-30 z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href={whatsappLinks.cotizarARL} target="_blank" rel="noopener noreferrer" class="bg-servir-green text-black min-w-64 sm:w-min md:w-72 font-bold py-3 px-8 text-xl rounded-2xl hover:opacity-90 transition-opacity text-center shadow-md">
            Activar mi ARL ahora
        </a> 
        <a href={whatsappLinks.hablarConAsesor} target="_blank" rel="noopener noreferrer" class="bg-gray-200 text-black min-w-64 sm:w-min md:w-72 font-bold py-3 px-8 text-xl rounded-2xl hover:bg-gray-300 transition-colors text-center shadow-md">
            Hablar con un asesor
        </a>
    </div>
</section>
