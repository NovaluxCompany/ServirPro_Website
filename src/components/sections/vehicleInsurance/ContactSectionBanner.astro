---
import { Image } from 'astro:assets';
import contactBannerWeb from '../../../assets/images/vehicleInsurance/Contact-banner.webp';
import contactBannerMobile from '../../../assets/images/vehicleInsurance/Contact-banner-mobile.webp';
---

<!-- Sección de Contacto -->
<section class="relative py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden min-h-[500px] lg:min-h-[670px]">
    <!-- Imagen de fondo para desktop -->
    <Image 
        src={contactBannerWeb} 
        alt="Contacto ServirPRO" 
        class="absolute inset-0 w-full h-full object-cover z-0 hidden sm:block"
        loading="lazy"
        quality={90}
    />
    
    <!-- Imagen de fondo para mobile -->
    <Image 
        src={contactBannerMobile} 
        alt="Contacto ServirPRO mobile" 
        class="absolute inset-0 w-full h-full object-cover z-0 sm:hidden"
        loading="lazy"
        quality={90}
    />

    <!-- Contenido -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-full flex flex-col justify-center">
        <div class="max-w-2xl mx-auto text-center sm:text-left sm:mx-0 sm:max-w-none">
            <!-- Título principal -->
            <h2 class="text-2xl sm:text-4xl lg:text-5xl text-left font-bold text-[#3b5881] mb-4 sm:mb-6 italic leading-tight" style="font-weight:900">
                Un seguro no solo<br class="hidden sm:block" />
                protege tu vehículo...
            </h2>
            <!-- Subtítulo -->
            <p class="text-base sm:text-xl lg:text-3xl text-servir-dark-text mb-6 lg:mb-16 leading-relaxed font-medium text-left" style="font-weight:700;">
                <span class="sm:hidden whitespace-pre-line" style="font-size:16px;">También cuida tu tranquilidad y
                 a quienes viajan contigo.</span>
                <span class="hidden sm:inline">También cuida tu tranquilidad y<br class="hidden sm:block" /> a quienes viajan contigo.</span>
            </p> 
        </div>

        <!-- Botones (mobile: flujo normal; desktop: overlay inferior con espaciado) -->
        <!-- Mobile -->
        <div class="flex flex-col gap-4 mt-8 justify-center items-center w-full sm:hidden">
            <a
                href="https://wa.me/573193029089?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20hablar%20con%20un%20asesor%20sobre%20p%C3%B3lizas%20de%20salud"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block text-center w-full sm:w-auto px-8 py-4 bg-gray-200 text-black font-bold rounded-full hover:bg-gray-300 transition-colors duration-300 max-w-[280px] cursor-pointer">
                Hablar con un asesor
            </a>
            <a
                href="https://wa.me/573193029089?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20cotizar%20una%20p%C3%B3liza%20de%20salud"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-servir-green inline-block text-center w-full sm:w-auto px-16 py-4 text-black font-bold rounded-full hover:opacity-90 transition-colors duration-300 max-w-[280px] cursor-pointer">
                Cotizar póliza
            </a>
        </div>

    </div>
    <!-- Desktop overlay (posicionado hacia la parte inferior de la imagen) -->
    <div class="hidden sm:flex gap-4 justify-center items-center w-full sm:absolute sm:inset-x-0 sm:bottom-10">
        <a
            href="https://wa.me/573193029089?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20hablar%20con%20un%20asesor%20sobre%20p%C3%B3lizas%20de%20salud"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-center px-8 py-4 bg-gray-200 text-black font-bold rounded-full hover:bg-gray-300 transition-colors duration-300 cursor-pointer">
            Hablar con un asesor
        </a>
        <a
            href="https://wa.me/573193029089?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20cotizar%20una%20p%C3%B3liza%20de%20salud"
            target="_blank"
            rel="noopener noreferrer"
            class="bg-servir-green inline-block text-center px-16 py-4 text-black font-bold rounded-full hover:opacity-90 transition-colors duration-300 cursor-pointer">
            Cotizar seguro
        </a>
    </div>
</section>