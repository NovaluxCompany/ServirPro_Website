---
import { Image } from 'astro:assets';
import BenefitItem from '../../ui/BenefitItem.astro';
 
// Imagen del título
import tituloImg from '../../../assets/images/homeInsurance/Detail-Title.webp';
import tituloImgMobile from '../../../assets/images/homeInsurance/Detail-Title-mobile.webp';


// Iconos
import icon1 from '../../../assets/iconos/homeInsurance/icon-home.svg';
import icon2 from '../../../assets/iconos/homeInsurance/icon-hammer.svg';
import icon3 from '../../../assets/iconos/homeInsurance/icon-drop.svg';
import icon4 from '../../../assets/iconos/homeInsurance/icon-tool.svg';
import icon5 from '../../../assets/iconos/homeInsurance/icon-home-hand.svg';

import { whatsappLinks } from "../../../utils/whatsapp";

---

<section class="w-full flex flex-col items-center justify-center text-center px-6 py-16 md:py-10 bg-white">
  <!-- Imagen del título -->
  <div class="mb-12">
    <Image src={tituloImg} alt="Una póliza de salud te brinda" class="mx-auto w-[400px] md:w-[600px] md:h-[120px] object-cover hidden sm:block"/>
    <Image src={tituloImgMobile} alt="Una póliza de salud te brinda" class="mx-auto w-[400px] md:w-[600px] md:h-[120px] object-cover sm:hidden"/>

  </div>

  <!-- Beneficios -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl mb-10">
    <BenefitItem 
      icon={icon1} 
      alt="Protección casa" 
      text={`Protección ante incendios, robos
       y desastres naturales.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon2} 
      alt="Responsabilidad legal" 
      text={`Responsabilidad civil frente
       a terceros.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon3} 
      alt="Cobertura" 
      text={`Cobertura por daños eléctricos o
       fugas de agua.`} 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon4} 
      alt="Herramienta" 
      text={`Asistencia en el hogar 24/7 
      (Plomería, cerrajería,
      electricidad). `} 
      showBorder={false}
      showBorderMobileOnly={true}

    />

    <BenefitItem 
      icon={icon5} 
      alt="Protección electrodomésticos"  
      text={`Protección de electrodomésticos,
       muebles y objetos de valor.`} 
      showBorderMobileOnly={false}
    />
    
  </div>

  <!-- Botón Cotizar -->
  <a href={whatsappLinks.cotizarSeguroHogar} target="_blank" rel="noopener noreferrer" class="button-text button-container  bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green transition mb-12">
    Cotizar seguro
  </a>

  <!-- Pasos -->
  <div class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative">
    <!-- Paso 1 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
      <p class="font-medium text-servir-dark-text step-text whitespace-pre-line description" >Cotiza tu seguro
         en minutos.</p>
    </div>

    <!-- Paso 2 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
      <p class="font-medium text-servir-dark-text step-text whitespace-pre-line description" >Elige la cobertura ideal
        para tu vivienda.</p>
    </div>

    <!-- Paso 3 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
      <p class="font-medium text-servir-dark-text step-text whitespace-pre-line description" >Vive con la
        tranquilidad de tener un hogar protegido.</p>
    </div>
  </div>


  <!-- Segundo botón -->
  <a href={whatsappLinks.cotizarSeguroHogar} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer md:w-[300px] text-[#000] font-bold px-8 py-3 rounded-full hover:bg-servir-green mb-6">
    Cotizar seguro
  </a>

</section>
