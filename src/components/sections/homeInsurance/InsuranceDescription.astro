---
import { Image } from 'astro:assets';
import detailBg from '../../../assets/images/vehicleInsurance/Detail-Banner.webp';
import detailBgMobile from '../../../assets/images/vehicleInsurance/Detail-Banner-mobile.webp';
---

<section
  class="relative bg-cover bg-center bg-no-repeat text-white overflow-hidden flex flex-col items-center justify-center text-center h-[450px] md:h-[600px] m-0 p-0 md:h-auto md:mt-10 md:px-2 md:py-30 lg:py-38 md:bg-transparent bg-servir-blue"
>
  <!-- Imagen de fondo: Desktop y Mobile -->
  <!-- Desktop -->
  <Image 
    src={detailBg} 
    alt="Fondo salud detalle" 
    class="absolute inset-0 w-full   h-[720px] lg:object-contain md:object-cover hidden md:block"
  />
  <!-- Mobile -->
  <Image 
    src={detailBgMobile} 
    alt="Fondo salud detalle móvil" 
    class="absolute inset-0 w-full h-[450px] object-contain md:hidden md:h-full"
  />

  <div class="relative z-10 max-w-3xl mx-auto flex flex-col items-center">
    <!-- Título -->
    <div class="bg-servir-blue-banner  p-[20px] md:px-10 md:py-3 w-[89%] md:w-[100%] md:w-100 rounded-[20px] inline-block mb-8 md:rounded-2xl ">
         <h2 class="text-2xl md:text-3xl font-semibold sm:text-lg">
        <span class="block md:inline md:whitespace-pre-line md:text-3xl text-lg">Un accidente, robo o daño
           inesperado puede dejarte con
           altos gastos y sin transporte
           en cuestión de segundos.</span>
      </h2>
    </div>


    <!-- Texto final -->
    <div class="bg-white text-[#3b5881]  text-lg font-extrabold italic rounded-2xl  p-[23px]  md:px-8 md:py-5 inline-block shadow-md text-lg md:text-3xl leading-snug mx-[23px] md:mx-0">
      <p>
          Sin un seguro, podrías asumir costos elevados de reparación, pérdidas totales o incluso responsabilidad por daños a terceros.
      </p>
    </div>
  </div>
</section>
