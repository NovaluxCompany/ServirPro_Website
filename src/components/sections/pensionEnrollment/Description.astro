---
import { Image } from "astro:assets";
import descriptionBg from "../../../assets/images/socialPension/FondoBlue-desk.webp";
import descriptionBgMobile from "../../../assets/images/socialPension/FondoBlue-mobile.webp";
import calendarIcon from "../../../assets/iconos/socialPension/CalendarioCheck.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<section class="py-12 px-4 md:py-3 md:px-8 bg-white flex justify-center">
  <div
    class="grid grid-cols-1 grid-rows-1 max-w-5xl mx-auto w-full place-items-center"
  >
    <!-- Imagen de fondo: Desktop y Mobile -->
    <!-- Usamos grid-area 1/1 para superponer -->
    <Image
      src={descriptionBg}
      alt="Fondo azul pension"
      class="col-start-1 row-start-1 w-full h-auto object-contain hidden md:block"
    />
    <Image
      src={descriptionBgMobile}
      alt="Fondo azul pension móvil"
      class="col-start-1 row-start-1 w-[90%] h-auto object-contain md:hidden"
    />

    <!-- Contenido encima de la imagen -->
    <div
      class="col-start-1 row-start-1 z-10 flex flex-col items-start w-full px-6 py-12 md:px-24 md:py-20"
    >
      <!-- Texto principal -->
      <!-- Mobile version -->
      <h2
        class="block md:hidden text-2xl font-bold text-white mb-4 leading-tight text-left w-[90%] mx-auto pl-6 mt-10"
      >
        <span class="block">Ahora puedes cotizar a</span>
        <span class="block">SOLO PENSIÓN, si cumples</span>
        <span class="block">los requisitos</span>
      </h2>

      <!-- Desktop version -->
      <h2
        class="hidden md:block text-4xl font-bold text-white mb-4 leading-tight text-left w-full mt-10"
      >
        <span class="block">Ahora puedes cotizar a SOLO PENSIÓN,</span>
        <span class="block">si cumples los requisitos</span>
      </h2>

      <!-- Tarjeta Blanca -->
      <div
        class="bg-white rounded-[30px] px-6 py-6 md:p-8 flex flex-col items-start gap-4 shadow-lg w-[90%] md:w-full mx-auto max-w-[54rem] border-4 border-white mb-10 md:mb-4 text-left"
      >
        <div class="flex items-start gap-4">
          <Image
            src={calendarIcon}
            alt="Icono calendario check"
            class="w-12 h-12 md:w-16 md:h-16 object-contain flex-shrink-0"
          />
          <p class="text-servir-blue-dark text-base md:text-xl font-medium leading-normal">
            La normatividad vigente contempla casos en los que es posible
            realizar aportes a pensión sin cotizar simultáneamente a EPS.
          </p>
        </div>

        <p class="text-servir-blue-dark text-lg md:text-xl font-extrabold">
          ¿Quieres saber si puedes hacerlo?
        </p>

        <p class="text-black text-base md:text-xl font-medium leading-normal">
          Cuéntanos tu situación y recibe orientación personalizada sobre los
          requisitos que debes cumplir.
        </p>

        <a
          target="_blank"
          href={whatsappLinks.cotizarPension}
          class="inline-block px-8 py-3 text-base md:text-lg font-bold text-black bg-servir-green rounded-xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1"
        >
          Consultar mi caso
        </a>
      </div>
    </div>
  </div>
</section>
