---
import { Image } from "astro:assets";
import descriptionBg from "../../../assets/images/socialPension/FondoBlue-desk.webp";
import descriptionBgMobile from "../../../assets/images/socialPension/FondoBlue-mobile.webp";
import calendarIcon from "../../../assets/iconos/socialPension/CalendarioCheck.webp";
---

<section class="py-12 px-4 md:py-20 md:px-8 bg-white flex justify-center">
  <div
    class="grid grid-cols-1 grid-rows-1 max-w-5xl mx-auto w-full place-items-center"
  >
    <!-- Imagen de fondo: Desktop y Mobile -->
    <!-- Usamos grid-area 1/1 para superponer -->
    <Image
      src={descriptionBg}
      alt="Fondo azul pension"
      class="col-start-1 row-start-1 w-full h-auto object-contain hidden md:block"
    />
    <Image
      src={descriptionBgMobile}
      alt="Fondo azul pension móvil"
      class="col-start-1 row-start-1 w-[90%] h-auto object-contain md:hidden"
    />

    <!-- Contenido encima de la imagen -->
    <div
      class="col-start-1 row-start-1 z-10 flex flex-col items-start w-full px-6 py-12 md:px-24 md:py-20"
    >
      <!-- Texto principal -->
      <!-- Mobile version -->
      <h2
        class="block md:hidden text-3xl font-bold text-white mb-4 leading-tight text-left w-[90%] mx-auto pl-6 mt-10"
      >
        <span class="block">Durante años,</span>
        <span class="block">muchas personas</span>
        <span class="block">quisieron pagar</span>
        <span class="block">solo pensión...</span>
        <span class="block">y no podían</span>
      </h2>

      <!-- Desktop version -->
      <h2
        class="hidden md:block text-5xl font-bold text-white mb-4 leading-tight text-left w-full mt-10"
      >
        <span class="block">Durante años, muchas</span>
        <span class="block">personas quisieron pagar</span>
        <span class="block">solo pensión... y no podían</span>
      </h2>

      <p
        class="text-[#344869] font-extrabold text-xl md:text-2xl mb-10 text-left w-[90%] md:w-full mx-auto pl-6 md:pl-0"
      >
        Hoy eso cambió.
      </p>

      <!-- Tarjeta Blanca -->
      <div
        class="bg-white rounded-[30px] px-4 py-4 md:p-5 grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2 md:gap-x-6 shadow-lg w-[90%] md:w-full mx-auto max-w-[54rem] border-4 border-white mb-10"
      >
        <!-- Icono -->
        <div
          class="flex-shrink-0 col-start-1 row-start-1 md:row-span-2 self-center"
        >
          <Image
            src={calendarIcon}
            alt="Icono calendario check"
            class="w-16 h-16 md:w-32 md:h-32 object-contain"
          />
        </div>

        <!-- Texto Titulo -->
        <h3
          class="col-start-2 row-start-1 text-servir-blue-dark text-base md:text-2xl font-extrabold text-left mb-0 leading-tight"
        >
          <span class="block md:inline">Ahora puedes cotizar</span>
          <span class="block md:inline">a solo pensión</span>
        </h3>

        <!-- Texto Parrafo -->
        <!-- Mobile version -->
        <p
          class="block md:hidden col-start-1 col-span-2 row-start-2 text-black text-sm font-medium leading-normal text-left"
        >
          <span class="block">Si eres beneficiario de EPS</span>
          <span class="block">o del régimen subsidiado, con</span>
          <span class="block">el acompañamiento correcto.</span>
        </p>

        <!-- Desktop version -->
        <p
          class="hidden md:block col-start-2 col-span-1 row-start-2 text-servir-blue-dark text-xl font-medium leading-normal text-left"
        >
          <span class="block">Si eres beneficiario de EPS o del régimen</span>
          <span class="block">subsidiado, con el acompañamiento correcto.</span>
        </p>
      </div>
    </div>
  </div>
</section>
