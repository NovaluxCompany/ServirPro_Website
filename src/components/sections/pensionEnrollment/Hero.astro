---
import { Image } from "astro:assets";
import heroBg from "../../../assets/images/socialPension/Hero-desk.webp";
import heroBgMobile from "../../../assets/images/socialPension/Hero-mobile.webp";
---

<section class="h-auto md:h-[600px] lg:h-[700px] relative overflow-hidden">
  <div class="w-full h-full relative">
    <!-- Imagen de fondo -->
    <Image
      src={heroBg}
      alt="Afiliaciones a Pensión"
      class="absolute inset-0 w-full h-full object-center object-cover hidden sm:block"
    />
    <Image
      src={heroBgMobile}
      alt="Afiliaciones a Pensión mobile"
      class="absolute inset-0 w-full h-full object-cover sm:hidden"
    />

    <!-- Contenido Overlay -->
    <div
      class="relative sm:absolute inset-0 flex items-center justify-center sm:justify-end p-6 sm:p-12 lg:p-20"
    >
      <div
        class="p-6 bg-transparent max-w-lg lg:max-w-xl text-left sm:mr-4 lg:mr-12 mt-56 pr-10"
      >
        <h1
          class="text-3xl md:text-3xl lg:text-4xl font-extrabold text-servir-blue-dark leading-tight mb-2"
        >
          <span class="block md:inline">Ahora sí</span>
          <span class="block md:inline">puedes cotizar a</span>
          <span class="block md:inline">SOLO PENSIÓN</span>
        </h1>
        <h2 class="text-2xl md:text-3xl font-bold text-servir-blue-dark mb-6">
          ¡Sin pagar EPS!
        </h2>

        <ul class="space-y-3 mb-8 text-black font-medium text-xs md:text-lg">
          <li class="flex items-center">
            <iconify-icon
              icon="fa6-solid:circle-check"
              class="text-servir-blue-dark mr-3 flex-shrink-0 w-4 h-4 md:w-5 md:h-5"
            ></iconify-icon>
            <span>Ideal para trabajadores informales</span>
          </li>
          <li class="flex items-center">
            <iconify-icon
              icon="fa6-solid:circle-check"
              class="text-servir-blue-dark mr-3 flex-shrink-0 w-4 h-4 md:w-5 md:h-5"
            ></iconify-icon>
            <span>Personas que ganen menos de 1 SMLV</span>
          </li>
          <li class="flex items-center">
            <iconify-icon
              icon="fa6-solid:circle-check"
              class="text-servir-blue-dark mr-3 flex-shrink-0 w-4 h-4 md:w-5 md:h-5"
            ></iconify-icon>
            <span>Beneficiario de EPS o régimen subsidiado</span>
          </li>
          <li class="flex items-center">
            <iconify-icon
              icon="fa6-solid:circle-check"
              class="text-servir-blue-dark mr-3 flex-shrink-0 w-4 h-4 md:w-5 md:h-5"
            ></iconify-icon>
            <span>Hazlo fácil, seguro y confiable con ServirPRO</span>
          </li>
        </ul>

        <a
          href="#planes-afiliaciones"
          class="inline-block px-8 py-2 sm:px-20 sm:py-3 text-lg font-bold text-black bg-servir-green rounded-2xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1 whitespace-nowrap"
        >
          Cotizar mi pensión
        </a>
      </div>
    </div>
  </div>
</section>
