---
import { Image } from "astro:assets";
import heroBg from "../../../assets/images/socialPension/Hero-desk.webp";
import heroBgMobile from "../../../assets/images/socialPension/Hero-mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<section class="h-auto md:h-[600px] lg:h-[700px] relative overflow-hidden">
  <div class="w-full h-full relative">
    <!-- Imagen de fondo -->
    <Image
      src={heroBg}
      alt="Afiliaciones a Pensión"
      class="absolute inset-0 w-full h-full object-center object-cover hidden sm:block"
    />
    <Image
      src={heroBgMobile}
      alt="Afiliaciones a Pensión mobile"
      class="absolute inset-0 w-full h-full object-cover sm:hidden"
    />

    <!-- Contenido Overlay -->
    <div
      class="relative sm:absolute inset-0 flex items-center justify-center sm:justify-end p-6 sm:p-12 lg:p-20 md:mb-70"
    >
      <div
        class="p-6 bg-transparent max-w-lg lg:max-w-xl text-left sm:mr-4 lg:mr-12 mt-56 pr-10"
      >
        <h1
          class="text-3xl lg:text-4xl font-extrabold text-servir-blue-dark leading-tight mb-4"
        >
          ¿Quieres cotizar a SOLO PENSIÓN?
        </h1>

        <p class="text-black font-medium text-sm md:text-lg mb-8 leading-relaxed">
          Si cumples las condiciones establecidas por la normatividad
          vigente, puedes realizar aportes a pensión sin tener que cotizar
          simultáneamente a EPS. Te orientamos para que conozcas si esta
          opción aplica para ti y cuáles son los requisitos.
        </p>

        <a
          target="_blank"
          href={whatsappLinks.cotizarPension}
          class="inline-block px-8 py-3 md:px-20 md:py-4 text-lg font-bold text-black bg-servir-green rounded-2xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1 whitespace-nowrap"
        >
          Consultar si aplico
        </a>

        <p class="mt-4 text-black font-medium text-xs md:text-base">
          Atención personalizada • Más de 10 años de experiencia
        </p>
      </div>
    </div>
  </div>
</section>
