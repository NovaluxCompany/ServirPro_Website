---
import { Image } from "astro:assets";
import iconPlanilla from "../../../assets/iconos/socialPension/Planilla.webp";
import iconCalendar from "../../../assets/iconos/socialPension/Calendar.webp";
import iconAlcancia from "../../../assets/iconos/socialPension/Alcancia.webp";
import iconVerificacion from "../../../assets/iconos/socialPension/Verificacion.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<section
  class="py-12 px-4 md:py-8 md:px-8 bg-gray-50 flex flex-col items-center"
>
  <div class="max-w-5xl mx-auto flex flex-col items-center">
    <!-- Title -->
    <h2 class="title text-2xl md:text-4xl font-extrabold text-servir-blue-dark mb-12 md:mb-16 text-center max-w-2xl">
      ¿Por qué cotizar a SOLO PENSIÓN?
    </h2>

    <!-- Grid of Benefits -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 mb-16 w-full max-w-4xl px-4 md:px-0"
    >
      <!-- Item 1 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconPlanilla}
            alt="Icono Planilla"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Continuar sumando semanas para tu pensión.
          </h3>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconCalendar}
            alt="Icono Calendario"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Mantener continuidad en tus aportes pensionales.
          </h3>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconAlcancia}
            alt="Icono Alcancia"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Continuar construyendo tu historial pensional.
          </h3>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconVerificacion}
            alt="Icono Verificacion"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Realizar aportes sin cotizar simultáneamente a EPS cuando tu
            situación y la normatividad aplicable lo permitan.
          </h3>
        </div>
      </div>
    </div>

    <!-- Button -->
    <div class="mb-8">
      <a
        target="_blank"
        href={whatsappLinks.cotizarPension}
        class="inline-block px-8 py-3 md:px-12 md:py-4 text-lg md:text-xl font-bold text-black bg-servir-green rounded-xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1"
      >
        Quiero recibir asesoría
      </a>
    </div>
  </div>
</section>
