---
import { Image } from "astro:assets";
import titleImage from "../../../assets/iconos/socialPension/Text.webp";
import iconPlanilla from "../../../assets/iconos/socialPension/Planilla.webp";
import iconCalendar from "../../../assets/iconos/socialPension/Calendar.webp";
import iconAlcancia from "../../../assets/iconos/socialPension/Alcancia.webp";
import iconVerificacion from "../../../assets/iconos/socialPension/Verificacion.webp";
---

<section
  class="py-12 px-4 md:py-8 md:px-8 bg-gray-50 flex flex-col items-center"
>
  <div class="max-w-5xl mx-auto flex flex-col items-center">
    <!-- Title Image -->
    <div class="mb-12 md:mb-16">
      <Image
        src={titleImage}
        alt="Cotizar a Solo Pensión te permite"
        class="h-auto w-full max-w-md md:max-w-xl object-contain mx-auto"
      />
    </div>

    <!-- Grid of Benefits -->
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-12 mb-16 w-full max-w-4xl px-4 md:px-0"
    >
      <!-- Item 1 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconPlanilla}
            alt="Icono Planilla"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Sumar semanas para tu pensión, <span
              class="font-normal text-gray-700"
              >sin interrumpir tu historial pensional.</span
            >
          </h3>
        </div>
      </div>

      <!-- Item 2 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconCalendar}
            alt="Icono Calendario"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Mantener continuidad en tus aportes, <span
              class="font-normal text-gray-700"
              >aunque tus ingresos no sean fijos.</span
            >
          </h3>
        </div>
      </div>

      <!-- Item 3 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconAlcancia}
            alt="Icono Alcancia"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Empezar a construir tu pensión desde hoy, <span
              class="font-normal text-gray-700"
              >incluso si trabajas informal o como independiente.</span
            >
          </h3>
        </div>
      </div>

      <!-- Item 4 -->
      <div class="flex items-start gap-4">
        <div class="flex-shrink-0">
          <Image
            src={iconVerificacion}
            alt="Icono Verificacion"
            class="w-12 h-12 md:w-16 md:h-16 object-contain"
          />
        </div>
        <div class="text-left">
          <h3
            class="text-servir-blue-dark font-extrabold text-lg md:text-xl leading-snug"
          >
            Hacer tu cotización con acompañamiento experto de ServirPRO Seguros, <span
              class="font-normal text-gray-700"
              >evitando errores o fraudes.</span
            >
          </h3>
        </div>
      </div>
    </div>

    <!-- Button -->
    <div class="mb-8">
      <a
        href="#planes-afiliaciones"
        class="inline-block px-8 py-3 md:px-12 md:py-4 text-lg md:text-xl font-bold text-black bg-servir-green rounded-xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1"
      >
        Quiero cotizar Solo Pensión
      </a>
    </div>

    <!-- Footer Text -->
    <p
      class="text-center text-black font-medium text-base md:text-lg max-w-3xl leading-snug px-4"
    >
      Nos encargamos de administrar tu cotización pensional y <br
        class="hidden md:block"
      /> te enviamos la planilla cada mes como soporte.
    </p>
  </div>
</section>
