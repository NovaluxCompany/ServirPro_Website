---
import { Image } from 'astro:assets';
import contactBannerWeb from '../../../assets/images/health-services/Contact-banner.webp';
import contactBannerMobile from '../../../assets/images/health-services/Contact-banner_mobile.webp';
---

<!-- Sección de Contacto -->
<section class="relative py-16 sm:py-20 lg:py-24 px-4 sm:px-6 lg:px-8 overflow-hidden min-h-[690px] lg:min-h-[670px]">
    <!-- Imagen de fondo para desktop -->
    <Image 
        src={contactBannerWeb} 
        alt="Contacto ServirPRO" 
        class="absolute inset-0 w-full h-full object-cover z-0 hidden sm:block"
        loading="lazy"
        quality={90}
    />
    
    <!-- Imagen de fondo para mobile -->
    <Image 
        src={contactBannerMobile} 
        alt="Contacto ServirPRO mobile" 
        class="absolute inset-0 w-full h-full object-cover z-0 sm:hidden"
        loading="lazy"
        quality={90}
    />

    <!-- Contenido -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto text-center sm:text-left sm:mx-0">
            <!-- Título principal -->
            <h2 class="text-2xl sm:text-4xl lg:text-4xl lg:text-center font-bold text-[#3b5881] mb-40 md:mb-7 italic leading-tight subtitle" style="font-weight:800">
                Viajas, trabajas, disfrutas la vida.
            </h2>
            
            <!-- Subtítulo -->
            <p class="text-base sm:text-xl text-servir-dark-text mb-1 md:mb-6 lg:mb-16 leading-relaxed font-medium lg:d-flex text-center subtitle" style="font-weight:700;">
                <span class="sm:hidden subtitle" style="font-size:16px;">Una póliza de salud acompaña tu estilo de vida con respaldo ilimitado, atención preferencial y cobertura internacional.</span>
                <span class="hidden sm:inline subtitle" style="font-size:25px;">Una póliza de salud acompaña tu estilo de vida con respaldo ilimitado, atención preferencial y cobertura internacional.</span>
            </p>
            
            <!-- Mensaje destacado -->
            <div class="bg-[#2b89c6] text-white px-6 py-3 rounded-lg inline-block mb-8  lg:flex justify-center subtitle">
                <p class="text-lg sm:text-xl font-semibold subtitle" style="font-weight:800;">
                    <span class="sm:hidden subtitle" style="font-size:18px;">Tu tranquilidad está asegurada.</span>
                    <span class="hidden sm:inline subtitle" style="font-size:30px;">Tu tranquilidad está asegurada.</span>
                </p>
            </div>
        </div>

        <!-- Botones (mobile: flujo normal; desktop: overlay inferior con espaciado) -->
        <!-- Mobile -->
        <div class="flex flex-col gap-4 mt-8 justify-center items-center w-full sm:hidden">
            <a
                href="https://wa.me/573011090186?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20hablar%20con%20un%20asesor%20sobre%20p%C3%B3lizas%20de%20salud"
                target="_blank"
                rel="noopener noreferrer"
                class="button-text button-container inline-block text-center w-full sm:w-auto px-8 py-4 bg-gray-200 text-black font-bold rounded-full hover:bg-gray-300 transition-colors duration-300 max-w-[280px] cursor-pointer button-text">
                Hablar con un asesor
            </a>
            <a
                href="https://wa.me/573011090186?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20cotizar%20una%20p%C3%B3liza%20de%20salud"
                target="_blank"
                rel="noopener noreferrer"
                class="button-text button-container bg-servir-green inline-block text-center w-full sm:w-auto px-16 py-4 text-black font-bold rounded-full hover:opacity-90 transition-colors duration-300 max-w-[280px] cursor-pointer button-text button-text">
                Cotizar póliza
            </a>
        </div>

    </div>
    <!-- Desktop overlay (posicionado hacia la parte inferior de la imagen) -->
    <div class="hidden sm:flex gap-4 justify-center items-center w-full sm:absolute sm:inset-x-0 sm:bottom-10">
        <a
            href="https://wa.me/573011090186?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20hablar%20con%20un%20asesor%20sobre%20p%C3%B3lizas%20de%20salud"
            target="_blank"
            rel="noopener noreferrer"
            class="button-text button-container inline-block text-center px-8 py-4 bg-gray-200 text-black font-bold rounded-full hover:bg-gray-300 transition-colors duration-300 cursor-pointer button-text">
            Hablar con un asesor
        </a>
        <a
            href="https://wa.me/573011090186?text=Hola%20vengo%20desde%20la%20p%C3%A1gina%20web%20y%20quiero%20cotizar%20una%20p%C3%B3liza%20de%20salud"
            target="_blank"
            rel="noopener noreferrer"
            class="button-text button-container bg-servir-green inline-block text-center px-16 py-4 text-black font-bold rounded-full hover:opacity-90 transition-colors duration-300 cursor-pointer button-text">
            Cotizar póliza
        </a>
    </div>
</section>