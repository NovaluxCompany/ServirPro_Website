---
import { Image } from "astro:assets";
import detailBg from "../../../assets/images/lifeInsurance/Health-detail.webp";
import detailBgMobile from "../../../assets/images/lifeInsurance/Health-detail-mobile.webp";
import { whatsappLinks } from "../../../utils/whatsapp";
---

<section
  class="relative bg-cover bg-center bg-no-repeat text-white overflow-hidden flex flex-col items-center justify-center text-center h-[690px] md:h-[650px] m-0 p-0 md:h-auto md:px-6 md:py-36"
>
  <!-- Imagen de fondo: Desktop y Mobile -->
  <!-- Desktop -->
  <Image
    src={detailBg}
    alt="Fondo salud detalle"
    class="absolute inset-0 w-full h-full object-cover hidden md:block md:max-w[95vw]"
    style="object-fit:contain"
  />
  <!-- Mobile -->
  <Image
    src={detailBgMobile}
    alt="Fondo salud detalle móvil"
    class="absolute inset-0 w-full h-[690px] object-cover md:hidden md:h-full"
  />

  <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
    <!-- Título -->
    <div
      class="bg-servir-blue-banner px-6 py-3 w-[95%] rounded-[20px] inline-block mb-3 md:w-auto md:rounded-lg"
    >
      <h2 class="text-2xl md:text-3xl subtitle">
        <span class="block md:inline subtile"
          >Evita errores y resuelve tus dudas antes de iniciar tu proceso</span
        >
      </h2>
    </div>

    <!-- Texto principal del cuerpo -->
    <p
      class="md:text-3xl text-lg leading-relaxed mb-6 text-white max-w-[85%] md:max-w-[100%] md:whitespace-pre-line subtitle"
    >Recibe atención personalizada según tu situación y conoce los requisitos y pasos que debes tener en cuenta.
    </p>

    <!-- Botón -->
    <a
      href={whatsappLinks.cotizarPlanSeguridadSocial}
      target="_blank"
      rel="noopener noreferrer"
      class="button-text button-container inline-block bg-servir-green text-black font-bold px-8 py-3 rounded-xl shadow-lg hover:bg-servir-green transition"
    >
      Quiero recibir asesoría
    </a>
  </div>
</section>
