---
import { Image } from 'astro:assets';
import BenefitItem from '../../ui/BenefitItem.astro';
 
// Imagen del título
import tituloImg from '../../../assets/images/vehiclePurchase/Detail-Title.png';
import tituloImgMobile from '../../../assets/images/vehiclePurchase/Detail-Title.png';


// Iconos
import icon1 from '../../../assets/iconos/vehiclePurchase/Icono1.svg';
import icon2 from '../../../assets/iconos/vehiclePurchase/Icono2.svg';
import icon3 from '../../../assets/iconos/vehiclePurchase/Icono3.svg';
import { whatsappLinks } from "../../../utils/whatsapp";

---

<section class="w-full flex flex-col items-center justify-center text-center px-6 py-16 md:py-10 bg-white">
  <!-- Imagen del título -->
  <div class="mb-6">
    <Image src={tituloImg} alt="Una póliza de salud te brinda" class="mx-auto max-w-full h-auto w-full md:max-w-[650px] object-contain hidden sm:block"/>
    <Image src={tituloImgMobile} alt="Una póliza de salud te brinda" class="mx-auto max-w-full h-auto w-full md:max-w-[400px] object-contain sm:hidden"/>
  </div>

  <!-- Subtítulo -->
  <div class="mb-12 max-w-4xl">
    <p class="description text-servir-dark-text leading-relaxed">
      Cambiamos tu crédito actual a una tasa más baja para que pagues menos intereses, reduzcas tu cuota mensual y tengas más tranquilidad financiera.
    </p>
  </div>

  <!-- Beneficios -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6 max-w-5xl mb-10">
    <BenefitItem 
      icon={icon1} 
      alt="Cuotas bajas" 
      text="Pagas cuotas más bajas cada mes." 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon2} 
      alt="Ahorro" 
      text="Ahorras dinero en intereses sin cambiar de vehículo." 
      showBorder={true}
    />

    <BenefitItem 
      icon={icon3} 
      alt="Menos tiempo" 
      text="Terminas de pagar tu crédito en menos tiempo." 
      showBorder={false}
    />
  </div>

  <!-- Botón Cotizar -->
  <a href={whatsappLinks.bajarCuotaVehiculo} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer w-full min-w-[330px] max-w-[500px] text-[#000] font-bold px-12 py-4 rounded-full hover:bg-servir-green transition mb-12">
    Bajar la cuota de mi crédito
  </a>

  <!-- Pasos -->
  <div class="mt-17 grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl w-full mb-17 relative">
    <!-- Paso 1 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">1.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Envíanos el extracto de tu crédito.</p>
    </div>

    <!-- Paso 2 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">2.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Te asesoramos y hacemos el estudio gratis.</p>
    </div>

    <!-- Paso 3 -->
    <div class="relative bg-[#e6e6e6] rounded-2xl p-6 pt-10 text-center shadow-sm flex flex-col items-center mb-6">
      <h3 class="absolute -top-6 text-5xl font-bold text-[#2b89c6]">3.</h3>
      <p class="font-medium text-servir-dark-text step-text description" >Una vez aprobado, empiezas a pagar menos.</p>
    </div>
  </div>


  <!-- Segundo botón -->
  <a href={whatsappLinks.bajarCuotaVehiculo} target="_blank" rel="noopener noreferrer" class="button-text button-container bg-servir-green cursor-pointer w-full min-w-[330px] max-w-[500px] text-[#000] font-bold px-12 py-4 rounded-full hover:bg-servir-green">
    Bajar la cuota de mi crédito
  </a>

</section>
