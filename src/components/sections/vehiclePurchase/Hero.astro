---
import { Image } from 'astro:assets';
import heroBg from '../../../assets/images/vehiclePurchase/Hero.webp';
import heroBgMobile from '../../../assets/images/vehiclePurchase/Hero-mobile.webp';
import { whatsappLinks } from '../../../utils/whatsapp';

const mainTitle = 'Baja la cuota de tu crédito vehicular';
const mainSubtitle = '';
const description = 'y paga menos desde este mes';
const detailedDescription = 'Si tienes un crédito de vehículo activo, podemos ayudarte a reducir tu cuota y mejorar tu tasa con bancos aliados y asesoría experta.';
const buttonText = 'Quiero bajar la cuota de mi crédito';
---

<section class="relative w-full h-auto md:h-[600px] lg:h-[650px] overflow-hidden py-12 md:py-0">
  <!-- Imagen de fondo Desktop -->
  <Image
    src={heroBg}
    alt="Compra de Cartera"
    class="absolute inset-0 w-full h-full object-cover hidden md:block"
  />

  <!-- Imagen de fondo Mobile -->
  <Image
    src={heroBgMobile}
    alt="Compra de Cartera Mobile"
    class="absolute inset-0 w-full h-full object-cover md:hidden"
  />

  <!-- Overlay -->
  <div class="absolute inset-0 bg-black/30"></div>

  <!-- Contenido -->
  <div class="relative z-10 h-full flex flex-col items-center justify-center text-center px-4 md:px-6 lg:px-8">
    <h1 class="title text-3xl md:text-4xl lg:text-5xl text-white font-bold mb-0 md:mb-0 leading-tight mt-32 md:mt-40 lg:mt-48">
      {mainTitle}
    </h1>

    <p class="subtitle text-xl md:text-2xl mb-6 md:mb-8 max-w-3xl font-bold text-white leading-tight">
      {description}
    </p>

    <p class="subtitle text-lg md:text-lg mb-6 md:mb-8 max-w-3xl text-white leading-tight font-normal">
      Si tienes un crédito de vehículo activo, podemos ayudarte a <span class="font-bold">reducir tu cuota y mejorar tu tasa</span> con bancos aliados y asesoría experta.
    </p>

    <a
      href={whatsappLinks.bajarCuotaVehiculo}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-8 md:px-12 py-3 md:py-4 bg-servir-green text-black font-bold rounded-full shadow-lg transition duration-300 ease-in-out hover:bg-servir-green/90 hover:shadow-xl hover:scale-105 mb-4 md:mb-6"
    >
      {buttonText}
    </a>

    <!-- Beneficios -->
    <div class="flex flex-col gap-1 md:gap-1.5 max-w-2xl text-left">
      <div class="flex items-center gap-3">
        <span class="text-servir-green text-xl md:text-2xl font-bold">✔</span>
        <span class="text-white text-base md:text-lg"><span class="font-bold">Sin costo</span> por asesoría</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-servir-green text-xl md:text-2xl font-bold">✔</span>
        <span class="text-white text-base md:text-lg">Proceso rápido y <span class="font-bold">seguro</span></span>
      </div>
      <div class="flex items-center gap-3">
        <span class="text-servir-green text-xl md:text-2xl font-bold">✔</span>
        <span class="text-white text-base md:text-lg">Acompañamiento de principio a fin</span>
      </div>
    </div>
  </div>
</section>