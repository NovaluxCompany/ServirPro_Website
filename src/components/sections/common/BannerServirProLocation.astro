---
import { Image } from "astro:assets";

import icon1 from "../../../assets/iconos/aditionalServices/servicies1.svg";
import icon2 from "../../../assets/iconos/aditionalServices/servicies2.svg";
import icon3 from "../../../assets/iconos/aditionalServices/servicies3.svg";

interface Item {
  icon: ImageMetadata;
  text: string;
  alt: string;
}

interface Props {
  title?: string;
  titleClass?: string;
  items?: Item[];
  buttonText?: string;
  buttonLink?: string;
  footerText?: string;
}

const {
  title = "Por qué miles confían en ServirPRO",
  titleClass = "text-servir-gray-dark",
  items = [
    {
      icon: icon1,
      text: "Más de 10 años afiliando<br> trabajadores y empresas<br> en todo el país",
      alt: "Icono de servicios",
    },
    {
      icon: icon2,
      text: "Oficinas físicas en <br> Medellín, Bogotá <br> y Pereira",
      alt: "Icono de servicios",
    },
    {
      icon: icon3,
      text: "Aliados directos de aseguradoras líderes en Colombia",
      alt: "Icono de servicios",
    },
  ],
  buttonText,
  buttonLink = "#",
  footerText,
} = Astro.props;
---

<section class="bg-gray-200 py-16 px-4 relative">
  <div class="max-w-7xl mx-auto flex flex-col items-center">
    <h2
      class={`text-2xl md:text-4xl text-center font-bold ${titleClass} title mb-12`}
      set:html={title}
    />

    <!-- Grid de estadísticas -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start mb-12 w-full">
      {
        items.map((item) => (
          <div class="flex flex-col items-center text-center">
            <div class="mb-6 h-20 md:h-32 flex items-end justify-center">
              <Image
                src={item.icon}
                alt={item.alt}
                class="w-20 h-20 md:w-28 md:h-28 object-contain"
              />
            </div>

            <p
              class="text-servir-gray text-xl md:text-2xl font-semibold subtitle leading-tight"
              set:html={item.text}
            />
          </div>
        ))
      }
    </div>

    {
      buttonText && (
        <div class="mb-4">
          <a
            href={buttonLink}
            class="inline-block px-8 py-3 md:px-12 md:py-4 text-lg md:text-xl font-bold text-black bg-servir-green rounded-xl shadow-lg transition duration-300 ease-in-out hover:bg-[#8CD556] hover:shadow-xl transform hover:-translate-y-1 text-center"
          >
            {buttonText}
          </a>
        </div>
      )
    }

    {
      footerText && (
        <p class="text-center text-black font-medium text-sm md:text-base max-w-3xl leading-snug px-4">
          {footerText}
        </p>
      )
    }
  </div>
</section>

<style>
  /* Animación opcional para los números */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  section > div > div.grid > div {
    animation: fadeInUp 0.6s ease-out;
  }

  section > div > div.grid > div:nth-child(1) {
    animation-delay: 0.1s;
  }

  section > div > div.grid > div:nth-child(2) {
    animation-delay: 0.2s;
  }

  section > div > div.grid > div:nth-child(3) {
    animation-delay: 0.3s;
  }
</style>
