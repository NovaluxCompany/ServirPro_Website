---
import { Image } from 'astro:assets';
import googleImage from '../../assets/iconos/google_icon_review.svg';

// ReviewCard.astro - Componente reutilizable para tarjetas de reseñas
export interface Props {
    name: string;
    initial: string;
    timeAgo: string;
    review: string;
    bgColor?: string;
}

// Client-side script to handle review expansion
const clientId = Math.random().toString(36).substring(2, 9);
const reviewId = `review-${clientId}`;

// Function to handle review expansion
const handleReviewClick = `
    const review = document.getElementById('${reviewId}');
    if (review) {
        review.classList.toggle('line-clamp-3'); 
        const dots = review.nextElementSibling;
        if (dots) {
            dots.textContent = review.classList.contains('line-clamp-3') ? '...' : '';
        }
    }
`;

const { name, initial, timeAgo, review, bgColor = "bg-blue-500" } = Astro.props;


---

<div class="flex-none w-full md:w-1/2 px-4 md:px-6">
    <div class="bg-gray-100 rounded-lg p-8 h-[95%] relative">
        <!-- Icono de Google en la esquina superior derecha -->
        <div class="absolute top-4 right-4">
            <Image src={googleImage} class="w-6 h-6" alt="Google icon" />
        </div>
        
        <!-- Layout responsive: centrado en móvil, horizontal en desktop -->
        <div class="flex flex-col items-center text-center md:flex-row md:items-center md:text-left mb-4">
            <div class={`w-12 h-12 ${bgColor} rounded-full flex items-center justify-center text-white font-bold mb-3 md:mb-0 md:mr-4 flex-shrink-0`}>
                {initial}
            </div>
            <div class="md:flex-1 md:min-w-0">
                <div class="font-semibold text-gray-800 md:truncate description">{name}</div>
                <div class="text-sm text-gray-500 description">{timeAgo}</div>
            </div>
        </div>
          <div class="flex text-yellow-400 mt-1 justify-center md:justify-start">
                    <!-- 5 estrellas -->
                    {Array.from({ length: 5 }).map(() => (
                        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                    ))}
                </div>
        <div class="relative">
            <p 
                id={reviewId}
                class="text-gray-700 text-sm text-center md:text-left line-clamp-3 cursor-pointer transition-all duration-200 description"
                onclick={handleReviewClick}
            >{review}</p>
            {review.length > 150 && (
                <span 
                    class="text-blue-500 cursor-pointer text-sm font-medium ml-1 mt-1 description
                    "
                    onclick={handleReviewClick}
                >Ver más</span>
            )}
        </div>
    </div>
</div>

<style>
    .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    
    /* Smooth transition for expanding/collapsing */
    .transition-all {
        transition: all 0.3s ease;
    }
</style>