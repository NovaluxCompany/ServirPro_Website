---
import { Image } from "astro:assets";

interface Props {
  icon: ImageMetadata;
  alt: string;
  text: string;
  title?: string; // Nuevo prop opcional
  colSpan?: boolean;
  showBorder?: boolean;
  showBorderMobileOnly?: boolean;
}

const {
  icon,
  alt,
  text,
  title = null, // Valor por defecto null
  colSpan = false,
  showBorder = false,
  showBorderMobileOnly = false,
} = Astro.props;

// Determinar las clases de borde
let borderClasses = "";
if (showBorderMobileOnly) {
  borderClasses =
    "border-b-2 border-servir-blue border-line-width-mobile md:border-b-0";
} else if (showBorder) {
  borderClasses = "border-b-2 border-servir-blue border-line-width";
}
---

<style>
  .border-line-width {
    border-bottom-width: 1.5px;
  }
  @media (max-width: 768px) {
    .border-line-width-mobile {
      border-bottom-width: 1.5px;
    }
  }
</style>

<div
  class={`flex items-center gap-4 pb-3 ${borderClasses} ${colSpan ? "md:col-span-2" : ""}`}
>
  <Image
    src={icon}
    alt={alt}
    class="w-12 h-12 shrink-0 text-servir-blue-banner"
  />
  <div>
    {title && (
      <h3 class="text-lg md:text-xl text-left font-medium text-[#1E4760] mb-2 sm:whitespace-pre-line description">
        {title}
      </h3>
    )}
    <p
      class="text-left font-semibold text-servir-gray-text sm:whitespace-pre-line description"
    >
      {text}
    </p>
  </div>
</div>