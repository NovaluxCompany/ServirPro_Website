---
// ServiceIcon.astro - Componente reutilizable para iconos de servicios
import { Image } from "astro:assets";


export interface Props {
  iconType:ImageMetadata;
  title: string;
  className?: string;
  href?: string;
}

const { iconType, title, className = "", href = "" } = Astro.props;



// Función para procesar el título y hacer las últimas palabras clave más bold
function processTitle(title: string) {
  // Palabras clave que deben ser más bold
  const keyWords = [
    "Salud",
    "Vida",
    "Autos y Motos",
    "Hogar",
    "EPS o ARL",
    "Seguridad Social",
    "ARL Empresas",
    "Colectivas",
  ];

  // Buscar si alguna palabra clave está al final del título
  for (const keyword of keyWords) {
    if (title.endsWith(keyword)) {
      const beforeKeyword = title.substring(0, title.length - keyword.length);
      return {
        beforeKeyword: beforeKeyword.trim(),
        keyword: keyword,
      };
    }
  }

  // Si no encuentra palabras clave específicas, hacer bold las últimas 1-2 palabras
  const words = title.split(" ");
  if (words.length >= 2) {
    const lastTwoWords = words.slice(-2).join(" ");
    const beforeLastTwo = words.slice(0, -2).join(" ");
    return {
      beforeKeyword: beforeLastTwo,
      keyword: lastTwoWords,
    };
  }

  return {
    beforeKeyword: "",
    keyword: title,
  };
}

const titleParts = processTitle(title);
---

<a
  href={href}
  class={`service-icon-link group cursor-pointer transform transition-all duration-200 md:hover:scale-110 -mx-1 md:mx-0 ${className}`}
  aria-label={title}
>
  <div
    class="bg-white rounded-full w-40 h-40 md:w-56 md:h-54 mx-auto flex flex-col items-center justify-center shadow-lg group-hover:shadow-xl transition-shadow duration-300 p-3 md:p-4"
  >
    <div class="mb-2">
      <Image
        src={iconType}
        alt={`${title} icon`}
        class="w-14 h-14 md:w-16 md:h-16"
        loading="lazy"
      />
    </div>
    <h3
      class="text-xs md:text-sm font-semibold text-gray-900 group-hover:text-servir-blue transition-colors duration-300 text-center leading-tight description"
    >
      {titleParts.beforeKeyword && <span>{titleParts.beforeKeyword} </span>}
      <span class="font-bold description">{titleParts.keyword}</span>
    </h3>
  </div>
</a>

<style>
   .service-icon-link {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  
  /* Efecto para desktop */
  @media (hover: hover) and (pointer: fine) {
    .service-icon-link:active {
      opacity: 0.6;
      transform: scale(0.92) !important;
      transition: all 0.15s ease-out;
    }
  }
  
  /* Efecto optimizado para mobile/touch */
  @media (hover: none) and (pointer: coarse) {
    .service-icon-link:active {
      opacity: 0.6 !important;
      transform: scale(0.92) !important;
      transition: all 0.1s ease-out !important;
    }
    
    /* Forzar el estado activo en WebKit (Safari/Chrome mobile) */
    .service-icon-link:active * {
      pointer-events: none;
    }
  }
  
  /* Fallback para todos los dispositivos táctiles */
  @media (pointer: coarse) {
    .service-icon-link:active {
      opacity: 0.6 !important;
      transform: scale(0.92) !important;
    }
  }
</style>
